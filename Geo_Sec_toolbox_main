        )
        parametro_superior = parameters[
            nombres.index("elevacion_superior")
        ]
        parametro_inferior = parameters[
            nombres.index("elevacion_inferior")
        ]

        if (
            modo_vertical in (
                "misma para todas",
                "personalizada"
            ) and
            (parametro_superior.value is None) !=
            (parametro_inferior.value is None)
        ):
