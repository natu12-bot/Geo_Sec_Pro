            def buscar_columna_csv(encabezados, candidatos):
                mapa = {
                    normalizar_encabezado_csv(nombre): nombre
                    for nombre in encabezados
                }

                for candidato in candidatos:
                    clave = normalizar_encabezado_csv(candidato)

                    if clave in mapa:
