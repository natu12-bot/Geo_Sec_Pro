    def updateParameters(self, parameters):
        nombres = [parametro.name for parametro in parameters]

        if "modo_escala_grafica" in nombres:
            modo_horizontal = normalizar_texto(
                parameters[
                    nombres.index("modo_escala_grafica")
                ].valueAsText
            )
            usar_control_horizontal = (
                modo_horizontal in (
                    "misma para todas",
                    "personalizada"
                )
            )

            parameters[
                nombres.index("longitud_marco")
            ].enabled = usar_control_horizontal
            parameters[
                nombres.index("escala_horizontal_objetivo")
            ].enabled = usar_control_horizontal

            # La barra grafica se calcula automaticamente para mantener comparabilidad.
            parameters[
                nombres.index("longitud_barra")
            ].enabled = False

        if "interpolar_geologia" in nombres:
            interpolar_activo = _valor_bool(
                parameters[
                    nombres.index("interpolar_geologia")
                ]
            )

            for nombre_control in (
                "continuidad",
                "criterio"
            ):
                if nombre_control in nombres:
                    parameters[
                        nombres.index(nombre_control)
                    ].enabled = interpolar_activo

        if "mostrar_nivel_freatico" in nombres:
            mostrar_nf = _valor_bool(
                parameters[
                    nombres.index("mostrar_nivel_freatico")
                ]
            )

            parametros_nf = (
                "metodo_nivel_freatico",
                "puntos_nivel_freatico",
                "campo_nivel_freatico",
                "escorrentias_nivel_freatico",
                "humedales_nivel_freatico",
                "inundable_nivel_freatico",
                "suavizado_nivel_freatico"
            )

            for nombre_nf in parametros_nf:
                if nombre_nf in nombres:
                    parameters[
                        nombres.index(nombre_nf)
                    ].enabled = mostrar_nf

            if mostrar_nf and "metodo_nivel_freatico" in nombres:
                metodo_nf = normalizar_texto(
                    parameters[
                        nombres.index("metodo_nivel_freatico")
                    ].valueAsText
                )
                requiere_observado = (
                    metodo_nf in ("hibrido", "solo observado")
                )
                for nombre_nf in (
                    "puntos_nivel_freatico",
                    "campo_nivel_freatico"
                ):
                    if nombre_nf in nombres:
                        parameters[
                            nombres.index(nombre_nf)
                        ].enabled = requiere_observado

        if "modo_vertical" in nombres:
            modo_vertical = normalizar_texto(
                parameters[
                    nombres.index("modo_vertical")
                ].valueAsText
            )
            usar_control_vertical = (
                modo_vertical in (
                    "misma para todas",
                    "personalizada"
                )
            )

            parameters[
                nombres.index("elevacion_superior")
            ].enabled = usar_control_vertical
            parameters[
                nombres.index("elevacion_inferior")
            ].enabled = usar_control_vertical
            parameters[
                nombres.index("escala_vertical_objetivo")
            ].enabled = usar_control_vertical
            parameters[
                nombres.index("rango_vertical_referencia")
            ].enabled = False
            parameters[
                nombres.index("margen_superior")
            ].enabled = (
                modo_vertical == "automatica"
            )

        return

    def updateMessages(self, parameters):
        nombres = [parametro.name for parametro in parameters]

        for nombre in (
            "margen_superior",
            "intervalo_eje_vertical",
            "escala_horizontal_objetivo",
            "escala_vertical_objetivo"
        ):
            if nombre not in nombres:
                continue

            parametro = parameters[nombres.index(nombre)]

            if (
                parametro.value is not None and
                float(parametro.value) <= 0
            ):
                parametro.setErrorMessage(
                    "El valor debe ser mayor que cero."
                )

        modo_horizontal = normalizar_texto(
            parameters[
                nombres.index("modo_escala_grafica")
            ].valueAsText
        )
        parametro_longitud = parameters[
            nombres.index("longitud_marco")
        ]

        if (
            parametro_longitud.value is not None and
            float(parametro_longitud.value) <= 0
        ):
            parametro_longitud.setErrorMessage(
                "La longitud horizontal debe ser mayor que cero."
            )

        if (
            modo_horizontal == "personalizada" and
            (
