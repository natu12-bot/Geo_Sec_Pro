                    ],
                    [boca_y, boca_y],
                    color="#1F1F1F",
                    linewidth=1.15,
                    zorder=92
                )

                nivel_etiqueta = niveles_etiqueta.get(
                    idx,
                    0
                )

                if x <= x_inicio + longitud_real * 0.08:
                    ha = "left"
                    x_texto = x + longitud_real * 0.012
                elif x >= x_fin - longitud_real * 0.08:
                    ha = "right"
                    x_texto = x - longitud_real * 0.012
                else:
                    ha = "center"
                    desplazamiento_x = (
                        (-1 if nivel_etiqueta % 2 else 1) *
                        longitud_real *
                        0.004 *
                        (nivel_etiqueta // 2)
                    )
                    x_texto = x + desplazamiento_x

                desplazamiento_etiqueta = (
                    2.0 + nivel_etiqueta * 2.3
                )
                elevacion_etiqueta = min(
                    z_boca_perfil + desplazamiento_etiqueta,
                    elevacion_superior - 1.0
                )

                # Si no existe espacio arriba, la etiqueta se coloca
                # debajo del collar pero siempre usando la misma escala
                # vertical que el eje de elevacion.
                alineacion_vertical_etiqueta = "bottom"

                if (
                    elevacion_etiqueta <=
                    z_boca_perfil + 0.25
                ):
                    elevacion_etiqueta = max(
                        base_horizontal + 1.0,
                        z_boca_perfil - 1.5
                    )
                    alineacion_vertical_etiqueta = "top"

                etiqueta_y = (
                    elevacion_etiqueta -
                    base_horizontal
                ) * ev

                # La linea guia termina exactamente en la elevacion real
                # del collar, haciendo evidente la correspondencia con
                # la escala vertical del eje.
                # Referencia horizontal de elevacion hacia el eje Y.
                ax.plot(
                    [x_inicio, x],
                    [boca_y, boca_y],
                    color="#777777",
                    linewidth=0.38,
                    linestyle="--",
                    alpha=0.62,
                    zorder=95
                )

                ax.plot(
                    [x, x_texto],
                    [boca_y, etiqueta_y],
                    color="#777777",
                    linewidth=0.35,
                    zorder=96
                )

                ax.text(
                    x_texto,
                    etiqueta_y,
                    texto_mpl(
                        "{0}\n{1:.1f} m s.n.m.".format(
                            control["sid"].replace(
                                "Sondeo ",
                                "S-"
                            ),
                            z_boca_perfil
                        )
                    ),
                    ha=ha,
                    va=alineacion_vertical_etiqueta,
                    fontsize=8,
                    fontweight="bold",
                    color="#202020",
                    zorder=100,
                    clip_on=False,
                    bbox=dict(
                        facecolor="white",
                        edgecolor="#777777",
                        linewidth=0.35,
                        alpha=0.90,
                        pad=0.7
                    )
                )

            # El punto de mayor elevacion del perfil de Factibilidad
            # siempre se etiqueta, aunque no coincida con un sondeo.
            indice_punto_maximo_fact = max(
                range(len(terreno)),
                key=lambda indice_local: terreno[indice_local]
            )
            x_punto_maximo_fact = grid_x[indice_punto_maximo_fact]
            z_punto_maximo_fact = float(
                terreno[indice_punto_maximo_fact]
            )

            if modo_horizontal_figura in (
                "personalizada",
                "misma para todas"
            ):
                limite_maximo_derecha_fact = (
                    x_inicio + longitud_referencia
                )
            else:
                limite_maximo_derecha_fact = x_fin

            ancho_visible_max_fact = max(
                limite_maximo_derecha_fact - x_inicio,
                1.0
            )
            margen_max_fact = min(
                ancho_visible_max_fact * 0.06,
                max(
                    ancho_visible_max_fact * 0.014,
                    25.0
                )
            )

            x_texto_maximo_fact = min(
                max(
                    x_punto_maximo_fact,
                    x_inicio + margen_max_fact
                ),
                limite_maximo_derecha_fact - margen_max_fact
            )

            colisiones_max_fact = 0
            for control_max_fact in controles:
                if (
                    abs(
                        x_texto_maximo_fact -
                        control_max_fact["x"]
                    ) <
                    separacion_minima_etiqueta * 0.85
                ):
                    colisiones_max_fact += 1

            desplazamiento_max_fact = (
                2.0 +
                min(colisiones_max_fact, 3) * 2.2
            )

            elevacion_texto_max_fact = min(
                z_punto_maximo_fact +
                desplazamiento_max_fact,
                elevacion_superior - 1.0
            )
            alineacion_vertical_max_fact = "bottom"

            if (
                elevacion_texto_max_fact <=
                z_punto_maximo_fact + 0.25
            ):
                elevacion_texto_max_fact = max(
                    base_horizontal + 1.0,
                    z_punto_maximo_fact - 1.5
                )
                alineacion_vertical_max_fact = "top"

            y_punto_maximo_fact = (
                z_punto_maximo_fact -
                base_horizontal
            ) * ev
            y_texto_maximo_fact = (
                elevacion_texto_max_fact -
                base_horizontal
            ) * ev

            fraccion_max_fact = (
                (x_texto_maximo_fact - x_inicio) /
                ancho_visible_max_fact
            )

            if fraccion_max_fact <= 0.10:
                ha_max_fact = "left"
            elif fraccion_max_fact >= 0.90:
                ha_max_fact = "right"
            else:
                ha_max_fact = "center"

            ax.scatter(
                [x_punto_maximo_fact],
                [y_punto_maximo_fact],
                s=13,
                c="#303030",
                marker="o",
                linewidths=0.0,
                zorder=101
            )

            ax.plot(
                [x_inicio, x_punto_maximo_fact],
                [y_punto_maximo_fact, y_punto_maximo_fact],
                color="#777777",
                linewidth=0.38,
                linestyle="--",
                alpha=0.62,
                zorder=97
            )

            ax.plot(
                [x_punto_maximo_fact, x_texto_maximo_fact],
                [y_punto_maximo_fact, y_texto_maximo_fact],
                color="#666666",
                linewidth=0.45,
                zorder=99
            )

            ax.text(
                x_texto_maximo_fact,
                y_texto_maximo_fact,
                texto_mpl(
                    "Max. {0:.1f} m s.n.m.".format(
                        z_punto_maximo_fact
                    )
                ),
                ha=ha_max_fact,
                va=alineacion_vertical_max_fact,
                fontsize=7.4,
                fontweight="bold",
                color="#202020",
                zorder=102,
                clip_on=True,
                bbox=dict(
                    facecolor="white",
                    edgecolor="#777777",
                    linewidth=0.30,
                    alpha=0.88,
                    pad=0.50
                )
            )

            msg_local(
                "Punto maximo Factibilidad etiquetado: "
                "{0:.1f} m s.n.m."
                .format(z_punto_maximo_fact)
            )

            if modo_horizontal_figura in (
                "personalizada",
                "misma para todas"
            ):
                limite_horizontal_final = (
                    x_inicio + longitud_referencia
                )
            else:
                limite_horizontal_final = x_fin

            ax.set_xlim(
                x_inicio,
                limite_horizontal_final
            )

            msg_local(
                "Marco horizontal aplicado: {0:.1f} a {1:.1f} m "
                "(amplitud {2:.1f} m)."
                .format(
                    x_inicio,
                    limite_horizontal_final,
                    limite_horizontal_final - x_inicio
                )
            )

            def formato_distancia_real(valor, posicion):
                distancia_real = (
                    valor /
                    max(factor_horizontal, 0.000001)
                )

                if abs(distancia_real) >= 10000:
                    return "{0:.0f}".format(distancia_real)

                if abs(distancia_real) >= 1000:
                    return "{0:.0f}".format(distancia_real)

                return "{0:g}".format(distancia_real)

            if FuncFormatter is not None:
                ax.xaxis.set_major_formatter(
                    FuncFormatter(
                        formato_distancia_real
                    )
                )

            if (
                modo_vertical_figura in (
                    "misma para todas",
                    "personalizada"
                ) and
                CONFIG_PROYECTO.get("elevacion_superior") is not None and
                CONFIG_PROYECTO.get("elevacion_inferior") is not None
            ):
                elevacion_superior_compartida = CONFIG_PROYECTO.get(
                    "elevacion_superior"
                )
                elevacion_inferior_compartida = CONFIG_PROYECTO.get(
                    "elevacion_inferior"
                )

                if (
                    elevacion_superior_compartida is not None and
                    elevacion_inferior_compartida is not None
                ):
                    # La base ya fue resuelta antes de dibujar.
                    elevacion_superior = float(
                        elevacion_superior_compartida
                    )

                altura_marco_m = max(
                    10.0,
                    elevacion_superior - base_horizontal
                )
            else:
                altura_marco_m = max(
                    10.0,
                    elevacion_superior - base_horizontal
                )

            ax.set_ylim(
                0,
                altura_marco_m * ev
            )

            def formato_elevacion(valor, posicion):
                return "{0:.0f}".format(
                    (valor / ev) + base_horizontal
                )

            if FuncFormatter is not None:
                ax.yaxis.set_major_formatter(
                    FuncFormatter(
                        formato_elevacion
                    )
                )

            # Todas las secciones usan exactamente el intervalo
            # vertical definido por el usuario.
            intervalo_mostrado = max(
                1.0,
                float(
                    CONFIG_PROYECTO.get(
                        "intervalo_eje_vertical",
                        intervalo_vertical
                    )
                )
            )

            # Las divisiones verticales se alinean con multiplos
            # exactos del intervalo indicado por el usuario.
            elevacion_minima_eje = float(base_horizontal)
            elevacion_maxima_eje = float(
                base_horizontal + altura_marco_m
            )
            primer_tick_elevacion = (
                math.floor(
                    elevacion_minima_eje /
                    intervalo_mostrado
                ) *
                intervalo_mostrado
            )
            ultimo_tick_elevacion = (
                math.ceil(
                    elevacion_maxima_eje /
                    intervalo_mostrado
                ) *
                intervalo_mostrado
            )

            ticks_verticales = []
            elevacion_tick = primer_tick_elevacion
            limite_ticks = 500
            contador_ticks = 0

            while (
                elevacion_tick <=
                ultimo_tick_elevacion + 0.000001 and
                contador_ticks < limite_ticks
            ):
                posicion_tick = (
                    elevacion_tick -
                    base_horizontal
                ) * ev

                if (
                    posicion_tick >= -0.000001 and
                    posicion_tick <=
                    altura_marco_m * ev + 0.000001
                ):
                    ticks_verticales.append(
                        posicion_tick
                    )

                elevacion_tick += intervalo_mostrado
                contador_ticks += 1

            if ticks_verticales:
                ax.set_yticks(ticks_verticales)
            elif MultipleLocator is not None:
                ax.yaxis.set_major_locator(
                    MultipleLocator(
                        intervalo_mostrado * ev
                    )
                )

            msg_local(
                "Intervalo vertical aplicado: {0:.1f} m."
                .format(intervalo_mostrado)
            )
            msg_local(
                "Anotaciones de elevacion referidas a la misma "
                "base vertical y EV del eje."
            )

            ax.set_xlabel(
                texto_mpl(
                    "Distancia acumulada desde {0} (m)".format(
                        etiqueta_inicio
                    )
                ),
                fontsize=10,
                labelpad=8
            )

            ax.set_ylabel(
                texto_mpl("Elevacion (m s.n.m.)"),
                fontsize=10
            )

            # Titulo independiente para dejar mayor espacio sobre la seccion.
            ax.set_title("")

            fig.suptitle(
                texto_mpl(titulo),
                fontsize=16,
                fontweight="bold",
                y=0.955
            )

            # Identificadores de los extremos tomados del nombre
            # real de la seccion.
            letra_inicio = etiqueta_inicio
            letra_fin = etiqueta_fin

            # Flechas de rumbo en la parte superior.
            y_flecha_superior = 1.035

            ax.annotate(
                "",
                xy=(0.015, y_flecha_superior),
                xytext=(0.115, y_flecha_superior),
                xycoords=ax.transAxes,
                textcoords=ax.transAxes,
                arrowprops=dict(
                    arrowstyle="-|>",
                    linewidth=1.25,
                    color="black"
                ),
                annotation_clip=False,
                zorder=145
            )

            ax.annotate(
                "",
                xy=(0.985, y_flecha_superior),
                xytext=(0.885, y_flecha_superior),
                xycoords=ax.transAxes,
                textcoords=ax.transAxes,
                arrowprops=dict(
                    arrowstyle="-|>",
                    linewidth=1.25,
                    color="black"
                ),
                annotation_clip=False,
                zorder=145
            )

            ax.text(
                0.065,
                y_flecha_superior + 0.018,
                texto_mpl(rumbo_izquierda),
                transform=ax.transAxes,
                ha="center",
                va="bottom",
                fontsize=9,
                fontweight="bold",
                clip_on=False
            )

            ax.text(
                0.935,
                y_flecha_superior + 0.018,
                texto_mpl(rumbo_derecha),
                transform=ax.transAxes,
                ha="center",
                va="bottom",
                fontsize=9,
                fontweight="bold",
                clip_on=False
            )

            ax.grid(False)

            # Letras de la seccion en la franja inferior.
            ax.text(
                0.008,
                -0.070,
                texto_mpl(etiqueta_inicio),
                transform=ax.transAxes,
                ha="left",
                va="top",
                fontsize=11,
                fontweight="bold",
                clip_on=False
            )

            ax.text(
                0.992,
                -0.070,
                texto_mpl(etiqueta_fin),
                transform=ax.transAxes,
                ha="right",
                va="top",
                fontsize=11,
                fontweight="bold",
                clip_on=False
            )

            ax.text(
                0.995,
                -0.135,
                (
                    "EH 1:{0:,}  |  EV 1:{1:,}"
                ).format(
                    int(escala_horizontal_real),
                    int(escala_vertical_real)
                ),
                transform=ax.transAxes,
                fontsize=6.5,
                ha="right",
                va="top",
                color="#444444",
                clip_on=False
            )

            # Barra de escala grafica.
            longitud_visible = longitud_real
            longitud_barra = max(
                float(longitud_escala),
                0.001
            )
            divisiones = max(divisiones_escala, 1)
            division = longitud_barra / float(divisiones)

            alcance_horizontal_grafico = max(
                limite_horizontal_final - x_inicio,
                1.0
            )
            ancho_barra_axes = min(
                0.95,
                max(
                    0.001,
                    longitud_barra /
                    alcance_horizontal_grafico
                )
            )
            x_barra_axes = 0.035
            y_barra_axes = -0.285
            altura_barra_axes = 0.025
            ancho_division_axes = ancho_barra_axes / float(divisiones)

            for i in range(divisiones):
                x0_axes = x_barra_axes + i * ancho_division_axes
                color_barra = "black" if i % 2 == 0 else "white"

                rectangulo_escala = plt.Rectangle(
                    (x0_axes, y_barra_axes),
                    ancho_division_axes,
                    altura_barra_axes,
                    transform=ax.transAxes,
                    facecolor=color_barra,
                    edgecolor="black",
                    linewidth=0.9,
                    zorder=130,
                    clip_on=False
                )
                ax.add_patch(rectangulo_escala)

            # Etiquetas bajo cada division, con formato legible.
            for i in range(divisiones + 1):
                x_tick_axes = x_barra_axes + i * ancho_division_axes
                valor_tick = i * division

                if abs(valor_tick) >= 1000:
                    etiqueta_tick = "{0:g}".format(valor_tick / 1000.0)
                else:
                    etiqueta_tick = "{0:g}".format(valor_tick)

                ax.text(
                    x_tick_axes,
                    y_barra_axes - 0.016,
                    etiqueta_tick,
                    transform=ax.transAxes,
                    ha="center",
                    va="top",
                    fontsize=7,
                    zorder=131,
                    clip_on=False
                )

            unidad_escala = "km" if longitud_barra >= 1000 else "m"

            ax.text(
                x_barra_axes + ancho_barra_axes + 0.012,
                y_barra_axes - 0.016,
                unidad_escala,
                transform=ax.transAxes,
                ha="left",
                va="top",
                fontsize=7,
                fontweight="bold",
                zorder=131,
                clip_on=False
            )

            ax.text(
                x_barra_axes + ancho_barra_axes / 2.0,
                y_barra_axes + altura_barra_axes + 0.016,
                "Escala",
                transform=ax.transAxes,
                ha="center",
                va="bottom",
                fontsize=8,
                fontweight="bold",
                zorder=131,
                clip_on=False
            )

            elementos_leyenda = []

            # Leyenda maestra comun para Factibilidad y Perfil 2D.
            # Se muestran siempre las unidades principales del proyecto
            # en exactamente el mismo orden, aunque una unidad no aparezca
            # en una seccion particular.
            claves_leyenda = [
                "material organico",
                "arcilla",
                "arena de grano fino",
                "gravas",
                "lutita"
            ]

            # Los simbolos hidrogeologicos tambien mantienen posicion fija
            # para que ambos tipos de seccion sean directamente comparables.
            claves_leyenda.extend([
                "__agua_superficial__",
                "__nivel_freatico_superior__",
                "__nivel_freatico_inferior__"
            ])

            msg_local(
                "Leyenda maestra aplicada: Material organico, Arcilla, "
                "Arena, Grava, Lutita, Cuerpo de agua y Nivel freatico."
            )

            cantidad_leyenda = max(
                1,
                len(claves_leyenda)
            )

            # La leyenda cambia a dos columnas cuando hay muchas
            # unidades y reduce tipografia antes de rebasar el cuadro.
            numero_columnas_leyenda = 1
            filas_leyenda = int(
                math.ceil(
                    cantidad_leyenda /
                    float(numero_columnas_leyenda)
                )
            )

            fuente_leyenda = 7.2

            alto_panel_leyenda = min(
                0.62,
                max(
                    0.34,
                    0.12 + filas_leyenda * 0.075
                )
            )
            y_panel_leyenda = max(
                0.20,
                0.56 - alto_panel_leyenda / 2.0
            )

            ax_leyenda = fig.add_axes(
                POSICION_LEYENDA
            )

            ax_leyenda.set_xlim(0, 1)
            ax_leyenda.set_ylim(0, 1)
            ax_leyenda.set_xticks([])
            ax_leyenda.set_yticks([])

            try:
                ax_leyenda.set_facecolor("white")
            except AttributeError:
                try:
                    ax_leyenda.set_axis_bgcolor("white")
                except Exception:
                    pass

            for borde in [
                "top", "right", "bottom", "left"
            ]:
                ax_leyenda.spines[borde].set_visible(True)
                ax_leyenda.spines[borde].set_linewidth(0.9)
                ax_leyenda.spines[borde].set_color("#555555")

            ax_leyenda.text(
                0.5,
                0.965,
                texto_mpl("Simbologia"),
                ha="center",
                va="top",
                fontsize=10,
                fontweight="bold"
            )

            margen_superior_leyenda = 0.82
            margen_inferior_leyenda = 0.08
            paso_vertical_leyenda = (
                (
                    margen_superior_leyenda -
                    margen_inferior_leyenda
                ) /
                float(max(filas_leyenda, 1))
            )
            ancho_columna_leyenda = (
                1.0 /
                float(numero_columnas_leyenda)
            )

            for indice_leyenda, clave in enumerate(
                claves_leyenda
            ):
                es_linea_nivel = clave in (
                    "__nivel_freatico_superior__",
                    "__nivel_freatico_inferior__"
                )

                if clave == "__agua_superficial__":
                    estilo_info = {
                        "color": "#79BCE8",
                        "trama": "",
                        "etiqueta": "Cuerpo de agua"
                    }
                elif clave == "__nivel_freatico_superior__":
                    estilo_info = {
                        "color": "#176FA6",
                        "trama": "",
                        "etiqueta": "Nivel freatico superior",
                        "linea": "--"
                    }
                elif clave == "__nivel_freatico_inferior__":
                    estilo_info = {
                        "color": "#176FA6",
                        "trama": "",
                        "etiqueta": "Nivel freatico inferior (-5 m)",
                        "linea": "-"
                    }
                else:
                    estilo_info = dict(
                        ESTILOS_LITOLOGIA[clave]
                    )

                    if clave == "material organico":
                        estilo_info["etiqueta"] = (
                            "Material organico"
                        )

                columna_leyenda = (
                    indice_leyenda //
                    filas_leyenda
                )
                fila_leyenda = (
                    indice_leyenda %
                    filas_leyenda
                )

                x_columna = (
                    columna_leyenda *
                    ancho_columna_leyenda
                )
                y_centro = (
                    margen_superior_leyenda -
                    (
                        fila_leyenda + 0.5
                    ) *
                    paso_vertical_leyenda
                )

                ancho_muestra = (
                    0.18
                    if numero_columnas_leyenda == 1
                    else 0.13
                )
                x_muestra = x_columna + 0.055
                alto_muestra = min(
                    0.055,
                    paso_vertical_leyenda * 0.50
                )

                if es_linea_nivel:
                    ax_leyenda.plot(
                        [x_muestra, x_muestra + ancho_muestra],
                        [y_centro, y_centro],
                        transform=ax_leyenda.transAxes,
                        color=estilo_info["color"],
                        linewidth=1.7,
                        linestyle=estilo_info.get("linea", "-"),
                        solid_capstyle="round"
                    )
                else:
                    muestra = plt.Rectangle(
                        (
                            x_muestra,
                            y_centro - alto_muestra / 2.0
                        ),
                        ancho_muestra,
                        alto_muestra,
                        transform=ax_leyenda.transAxes,
                        facecolor=estilo_info["color"],
                        edgecolor="#111111",
                        linewidth=0.9,
                        hatch=(
                            estilo_info["trama"]
                            if activar_trama
                            else None
                        )
                    )
                    ax_leyenda.add_patch(muestra)

                maximo_caracteres = (
                    24
                    if numero_columnas_leyenda == 1
                    else 13
                )
                etiqueta_ajustada = _envolver_texto_leyenda(
                    estilo_info["etiqueta"],
                    maximo_caracteres
                )

                ax_leyenda.text(
                    x_muestra + ancho_muestra + 0.035,
                    y_centro,
                    texto_mpl(etiqueta_ajustada),
                    transform=ax_leyenda.transAxes,
                    ha="left",
                    va="center",
                    fontsize=fuente_leyenda,
                    linespacing=0.92
                )

            fig.subplots_adjust(
                left=0.075,
                right=0.725,
                top=0.82,
                bottom=0.285
            )

            # Posicion fisica identica para Factibilidad y Perfil 2D.
            ax.set_position(
                POSICION_PERFIL
            )

            if not os.path.isdir(
                carpeta_graficos
            ):
                os.makedirs(
                    carpeta_graficos
                )

            nombre_base = (
                "Seccion_Geologica_" +
                sufijo
            )

            ruta_png = os.path.join(
                carpeta_graficos,
                nombre_base + ".png"
            )

            msg_local(
                "Etapa 5/6: exportando imagenes..."
            )

            fig.savefig(
                ruta_png,
                dpi=DPI_SALIDA,
                facecolor="white"
            )

            plt.close(fig)

            # TABLA EXCEL DE CONTROL LITOLOGICO
            bandas_control = [
                (0.0, 10.0),
                (10.0, 20.0),
                (20.0, 30.0)
            ]

            def dominante_sondeo(control, desde_banda, hasta_banda):
                acumulado = {}

                for intervalo in control["intervalos_exactos"]:
                    solape = max(
                        0.0,
                        min(intervalo["hasta"], hasta_banda) -
                        max(intervalo["desde"], desde_banda)
                    )

                    if solape <= 0:
                        continue

                    clave = intervalo["estilo"]

                    if clave == "lutita":
                        clave = "lutita gris"

                    acumulado[clave] = (
                        acumulado.get(clave, 0.0) +
                        solape
                    )

                if not acumulado:
                    return "Sin informacion", 0.0

                clave_dominante = max(
                    acumulado.keys(),
                    key=lambda clave: acumulado[clave]
                )

                etiqueta = ESTILOS_LITOLOGIA.get(
                    clave_dominante,
                    ESTILOS_LITOLOGIA["otro"]
                )["etiqueta"]

                return etiqueta, acumulado[clave_dominante]

            encabezados_excel = [
                "SONDEO",
                "PROFUNDIDAD TOTAL (m)",
                "LITOLOGIA 0-10 m",
                "ESPESOR DOMINANTE 0-10 m",
                "LITOLOGIA 10-20 m",
                "ESPESOR DOMINANTE 10-20 m",
                "LITOLOGIA 20-30 m",
                "ESPESOR DOMINANTE 20-30 m"
            ]

            filas_excel = []

            for control in controles:
                fila_excel = [
                    texto_unicode(control["sid"]),
                    round(float(control["profundidad"]), 2)
                ]

                for desde_banda, hasta_banda in bandas_control:
                    etiqueta, espesor = dominante_sondeo(
                        control,
                        desde_banda,
                        hasta_banda
                    )

                    fila_excel.extend([
                        texto_unicode(etiqueta),
                        round(float(espesor), 2)
                    ])

                filas_excel.append(fila_excel)

            msg_local(
                "Etapa 6/6: generando reporte Excel..."
            )

            ruta_excel = os.path.join(
                carpeta_graficos,
                "Control_Litologico_" + sufijo + ".xlsx"
            )

            # Resumen acumulado por intervalo de profundidad.
            categorias_resumen = [
                "Arcilla",
                "Arena",
                "Lutita",
                "Gravas/Conglomerado",
                "Otra Litologia"
            ]

            bandas_resumen = [
                (0.0, 10.0, "0-10"),
                (10.0, 20.0, "10-20"),
                (20.0, 30.0, "20-30")
            ]

            resumenes_litologicos = []

            def categoria_resumen(estilo_resumen):
                clave_resumen = normalizar(
                    estilo_resumen
                )

                if "arcilla" in clave_resumen:
                    return "Arcilla"
                if (
                    "arena" in clave_resumen or
                    "arenisca" in clave_resumen
                ):
                    return "Arena"
                if "lutita" in clave_resumen:
                    return "Lutita"
                if (
                    "grava" in clave_resumen or
                    "conglomerado" in clave_resumen
                ):
                    return "Gravas/Conglomerado"

                texto_nuevo = texto_unicode(
                    estilo_resumen
                ).strip()

                if not texto_nuevo:
                    return "Otra Litologia"

                return u" ".join(
                    palabra.capitalize()
                    for palabra in normalizar(
                        texto_nuevo
                    ).split()
                ) or "Otra Litologia"

            for desde_resumen, hasta_resumen, nombre_banda in bandas_resumen:
                acumulados_resumen = dict(
                    (categoria, 0.0)
                    for categoria in categorias_resumen
                )

                for control_resumen in controles:
                    for intervalo_resumen in control_resumen[
                        "intervalos_exactos"
                    ]:
                        solape_resumen = max(
                            0.0,
                            min(
                                intervalo_resumen["hasta"],
                                hasta_resumen
                            ) -
                            max(
                                intervalo_resumen["desde"],
                                desde_resumen
                            )
                        )

                        if solape_resumen <= 0:
                            continue

                        categoria = categoria_resumen(
                            intervalo_resumen.get(
                                "litologia",
                                intervalo_resumen.get(
                                    "estilo",
                                    ""
                                )
                            )
                        )
                        if categoria not in acumulados_resumen:
                            acumulados_resumen[categoria] = 0.0

                        acumulados_resumen[categoria] += solape_resumen

                total_resumen = sum(
                    acumulados_resumen.values()
                )

                filas_excel.append([])
                filas_excel.append([
                    "Litologia " + nombre_banda,
                    "Total (m)",
                    "Porcentaje"
                ])

                valores_pastel = []
                etiquetas_pastel = []

                categorias_salida = list(
                    categorias_resumen
                )

                categorias_salida.extend(
                    sorted(
                        [
                            categoria
                            for categoria in acumulados_resumen.keys()
                            if categoria not in categorias_salida
                        ]
                    )
                )

                for categoria in categorias_salida:
                    valor_categoria = acumulados_resumen[categoria]
                    porcentaje_categoria = (
                        100.0 * valor_categoria / total_resumen
                        if total_resumen > 0
                        else 0.0
                    )

                    filas_excel.append([
                        categoria,
                        round(valor_categoria, 2),
                        round(porcentaje_categoria, 2)
                    ])

                    if valor_categoria > 0:
                        etiquetas_pastel.append(categoria)
                        valores_pastel.append(valor_categoria)

                resumenes_litologicos.append(
                    (
                        nombre_banda,
                        etiquetas_pastel,
                        valores_pastel
                    )
                )

            escribir_xlsx_control_con_graficos(
                ruta_excel,
                encabezados_excel,
                filas_excel,
                resumenes_litologicos,
                len(controles)
            )

            msg_local(
                "Total de puntos utilizados en la seccion: {0}."
                .format(len(controles))
            )

            # Los graficos de pastel se incorporan dentro
            # del archivo Excel mediante el escritor con graficos.

            msg_local("Excel de control litologico: " + ruta_excel)
            msg_local("Seccion geologica interpretada correctamente.")
            msg_local("PNG: " + ruta_png)

        except Exception:
            arcpy.AddError(
                traceback.format_exc()
            )
            raise

# Motor de perfiles geologicos 2D


class _MotorPerfil2D(object):
    def __init__(self):
        self.label = "Generar perfil geologico 2D"
        self.description = "Genera un perfil geologico 2D a partir de una linea de seccion y una tabla CSV de puntos y litologias."
        self.canRunInBackground = False

    def getParameterInfo(self):
        p0 = arcpy.Parameter(
            displayName="Linea 3D de seccion",
            name="linea_3d",
            datatype="GPFeatureLayer",
            parameterType="Required",
            direction="Input"
        )
        p0.filter.list = ["Polyline"]

        p1 = arcpy.Parameter(
            displayName="CSV de puntos y litologia 2D",
            name="csv_litologia_2d",
            datatype="DEFile",
            parameterType="Required",
            direction="Input"
        )
        p1.filter.list = ["csv", "txt"]

        p2 = arcpy.Parameter(
            displayName="Carpeta de salida",
            name="carpeta_salida",
            datatype="DEFolder",
            parameterType="Required",
            direction="Input"
        )

        p3 = arcpy.Parameter(
            displayName="Nombre corto de la seccion",
            name="nombre_seccion",
            datatype="GPString",
            parameterType="Required",
            direction="Input"
        )
        p3.value = "AA"

        p4 = arcpy.Parameter(
            displayName="Titulo",
            name="titulo",
            datatype="GPString",
            parameterType="Required",
            direction="Input"
        )
        p4.value = "Seccion Geologica A-A'"

        p5 = arcpy.Parameter(
            displayName="Radio maximo de seleccion lateral (m)",
            name="radio_proyeccion",
            datatype="GPDouble",
            parameterType="Required",
            direction="Input"
        )
        p5.value = 250.0

        p6 = arcpy.Parameter(
            displayName="Separacion minima para eliminar duplicados (m)",
            name="separacion_duplicados",
            datatype="GPDouble",
            parameterType="Required",
            direction="Input"
        )
        p6.value = 5.0

        p7 = arcpy.Parameter(
            displayName="Profundidad total de interpretacion (m)",
            name="profundidad_interpretacion",
            datatype="GPDouble",
            parameterType="Required",
            direction="Input"
        )
        p7.value = 40.0

        p8 = arcpy.Parameter(
            displayName="Exageracion vertical",
            name="exageracion_vertical",
            datatype="GPDouble",
            parameterType="Required",
            direction="Input"
        )
        p8.value = 1.0

        p9 = arcpy.Parameter(
            displayName="Suavizado topografico (ventana)",
            name="ventana_suavizado",
            datatype="GPLong",
            parameterType="Required",
            direction="Input"
        )
        p9.value = 41

        p10 = arcpy.Parameter(
            displayName="Numero de muestras de interpolacion",
            name="numero_muestras",
            datatype="GPLong",
            parameterType="Required",
            direction="Input"
        )
        p10.value = 700

        p11 = arcpy.Parameter(
            displayName="Suavizado de contactos (iteraciones)",
            name="suavizado_contactos",
            datatype="GPLong",
            parameterType="Required",
            direction="Input"
        )
        p11.value = 14

        p12 = arcpy.Parameter(
            displayName="Margen horizontal del grafico (%)",
            name="margen_horizontal",
            datatype="GPDouble",
            parameterType="Required",
            direction="Input"
        )
        p12.value = 2.5

        p13 = arcpy.Parameter(
            displayName="Intervalo vertical minimo (m)",
            name="intervalo_vertical",
            datatype="GPDouble",
            parameterType="Required",
            direction="Input"
        )
        p13.value = 5.0

        p14 = arcpy.Parameter(
            displayName="Escala horizontal de referencia (1:N)",
            name="escala_horizontal",
            datatype="GPLong",
            parameterType="Required",
            direction="Input"
        )
        p14.value = 2000

        p15 = arcpy.Parameter(
            displayName="Longitud de la escala grafica (m; 0 = automatica)",
            name="longitud_escala",
            datatype="GPDouble",
            parameterType="Required",
            direction="Input"
        )
        p15.value = 0.0

        p16 = arcpy.Parameter(
            displayName="Divisiones de la escala grafica",
            name="divisiones_escala",
            datatype="GPLong",
            parameterType="Required",
            direction="Input"
        )
        p16.value = 5

        p17 = arcpy.Parameter(
            displayName="Mostrar tramas litologicas",
            name="usar_trama",
            datatype="GPBoolean",
            parameterType="Required",
            direction="Input"
        )
        p17.value = False

        p18 = arcpy.Parameter(
            displayName="Criterio litologico",
            name="criterio_litologico",
            datatype="GPString",
            parameterType="Required",
            direction="Input"
        )
        p18.filter.type = "ValueList"
        p18.filter.list = [
            "Esperada",
            "Comun"
        ]
        p18.value = "Comun"

        p19 = arcpy.Parameter(
            displayName="Potencia del interpolado",
            name="potencia_interpolado",
            datatype="GPDouble",
            parameterType="Required",
            direction="Input"
        )
        p19.value = 2.0

        p20 = arcpy.Parameter(
            displayName="Puntos de Factibilidad para correlacion (max. 2000 m)",
            name="puntos_factibilidad_cercanos",
            datatype="GPFeatureLayer",
            parameterType="Optional",
            direction="Input"
        )
        p20.filter.list = ["Point"]

        return [
            p0, p1, p2, p3, p4, p5, p6, p7, p8,
            p9, p10, p11, p12, p13, p14, p15, p16, p17,
            p18, p19, p20
        ]

    def isLicensed(self):
        return True

    def updateParameters(self, parameters):
        return

    def updateMessages(self, parameters):
        positivos = [
            5, 6, 7, 8, 9, 10, 12,
            13, 14, 16
        ]

        for idx in positivos:
            if parameters[idx].value is not None:
                if float(parameters[idx].value) <= 0:
                    parameters[idx].setErrorMessage(
                        "El valor debe ser mayor que cero."
                    )

        if parameters[11].value is not None:
            if int(parameters[11].value) < 0:
                parameters[11].setErrorMessage(
                    "Las iteraciones no pueden ser negativas."
                )

        if parameters[15].value is not None:
            if float(parameters[15].value) < 0:
                parameters[15].setErrorMessage(
                    "Use 0 para escala automatica o un valor positivo."
                )

        if parameters[19].value is not None:
            if float(parameters[19].value) <= 0:
                parameters[19].setErrorMessage(
                    "La potencia debe ser mayor que cero."
                )

        return

    def execute(self, parameters, messages):
        # Referencias locales para mensajes y validaciones.
        msg_local = msg
        warn_local = warn
        error_local = error

        linea_3d = parameters[0].valueAsText
        archivo_csv_litologias = parameters[1].valueAsText
        carpeta_graficos = parameters[2].valueAsText
        sufijo_original = parameters[3].valueAsText
        titulo = texto_unicode(parameters[4].valueAsText)

        radio = float(parameters[5].value)
        separacion_duplicados = float(parameters[6].value)
        profundidad_interpretacion = float(parameters[7].value)
        ev = float(parameters[8].value)
        ventana = int(parameters[9].value)
        numero_muestras = int(parameters[10].value)
        iter_suavizado = int(parameters[11].value)
        margen_horizontal_pct = (
            float(parameters[12].value) / 100.0
        )
        intervalo_vertical = float(parameters[13].value)
        escala_horizontal = int(parameters[14].value)
        longitud_escala_usuario = float(parameters[15].value)
        divisiones_escala = int(parameters[16].value)
        activar_trama = bool(parameters[17].value)
        criterio_litologico = texto_unicode(
            parameters[18].valueAsText
        ).strip().lower()

        usar_litologia_comun = (
