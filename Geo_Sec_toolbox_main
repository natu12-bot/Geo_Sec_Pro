class _ParametroInterno(object):
    def __init__(self, valor=None, nombre=None):
        self.name = nombre
        self.value = valor
        self.valueAsText = (
            None if valor is None else texto_unicode(valor)
        )


def _clonar_parametros_lote(parametros):
    """
    Crea una copia independiente y estable de los parametros del lote.

    Las capas, tablas, rutas, campos y textos se conservan mediante
    valueAsText para no transferir objetos Layer temporales entre
    ejecuciones. Los valores numericos y booleanos conservan su tipo.
    """
    copia = []

    for parametro in parametros:
        nombre = getattr(
            parametro,
            "name",
            None
        )

        try:
            tipo = texto_unicode(
                getattr(
                    parametro,
                    "datatype",
                    ""
                )
            ).strip().lower()
        except Exception:
            tipo = ""

        es_escalar = (
            "double" in tipo or
            "long" in tipo or
            "boolean" in tipo
        )

        if es_escalar:
            try:
                valor = parametro.value
            except Exception:
                valor = None
        else:
            try:
                valor = parametro.valueAsText
            except Exception:
                try:
                    valor = texto_unicode(
                        parametro.value
                    )
                except Exception:
                    valor = None

        copia.append(
            _ParametroInterno(
                valor,
                nombre
            )
        )

    return copia


def _valor_bool(parametro):
    try:
        return bool(parametro.value)
    except Exception:
        return False


def _letra_seccion(indice):
    """
    Convierte 1, 2, ..., 26, 27 en A, B, ..., Z, AA.
    """
    indice = max(1, int(indice))
    resultado = ""

    while indice > 0:
        indice -= 1
        resultado = chr(65 + indice % 26) + resultado
        indice //= 26

    return resultado


def _identificador_desde_campo(valor, tipo, alternativo):
    """
    Normaliza nombres como A-A', AA, 1-1' o Seccion 04.
    tipo: 'factibilidad' o '2d'.

    Esta funcion solo utiliza auxiliares globales para funcionar igual
    en ejecucion individual y por lote.
    """
    original = texto_unicode(valor).strip()
    tipo = texto_unicode(tipo).strip().lower()
    alternativo = texto_unicode(alternativo).strip()

    if not original:
        return alternativo

    limpio = normalizar_texto(original)

    if tipo == "2d":
        numeros = re.findall(ur"\d+", limpio)

        if numeros:
            try:
                return str(int(numeros[0]))
            except Exception:
                return numeros[0]

        return alternativo

    # Factibilidad: priorizar la primera letra significativa.
    letras = re.findall(ur"[a-z]+", limpio)

    if letras:
        candidato = letras[0].upper()

        # Evitar que "Seccion A-A'" produzca S.
        if candidato in ("SECCION", "SECCION") and len(letras) > 1:
            candidato = letras[1].upper()

        return candidato[0:2] or alternativo

    return alternativo


def _aplicar_suavizado_topografico(valores, ventana_base):
    """Aplica el suavizado topografico sin depender de funciones locales."""
    valores_base = list(valores)

    if len(valores_base) < 3:
        return valores_base

    modo = texto_unicode(
        CONFIG_PROYECTO.get(
            "suavizado_topografico",
            "automatico"
        )
    ).strip().lower()

    if modo in ("sin suavizado", "ninguno"):
        return valores_base

    ventana_base = max(3, int(ventana_base or 3))

    if modo == "bajo":
        ventana_topografica = max(5, ventana_base // 4)
        iteraciones_topograficas = 2
    elif modo == "medio":
        ventana_topografica = max(9, ventana_base // 3)
        iteraciones_topograficas = 3
    elif modo == "alto":
        ventana_topografica = max(15, ventana_base)
        iteraciones_topograficas = 5
    else:
        # Automatico conserva el comportamiento de referencia.
        ventana_topografica = max(11, ventana_base // 2)
        iteraciones_topograficas = 4

    # La ventana siempre debe ser impar y no superar la serie.
    ventana_topografica = min(
        ventana_topografica,
        len(valores_base)
    )

    if ventana_topografica % 2 == 0:
        ventana_topografica -= 1

    ventana_topografica = max(
        3,
        ventana_topografica
    )

    def _media_movil_topografica(serie, ventana_local):
        mitad = ventana_local // 2
        salida = []

        for indice in range(len(serie)):
            inicio = max(
                0,
                indice - mitad
            )
            fin = min(
                len(serie),
                indice + mitad + 1
            )
            segmento = serie[inicio:fin]

            salida.append(
                sum(segmento) /
                float(len(segmento))
            )

        return salida

    resultado = valores_base

    for _ in range(
        max(1, iteraciones_topograficas)
    ):
        resultado = _media_movil_topografica(
            resultado,
            ventana_topografica
        )

    return resultado


