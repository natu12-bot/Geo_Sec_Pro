def texto_mpl(valor):
    """
    Convierte textos dinamicos a una cadena ASCII segura para
    Matplotlib incluido en ArcGIS Desktop 10.8 / Python 2.7.
    """
    valor_unicode = texto_unicode(valor)

    try:
        valor_normalizado = unicodedata.normalize(
            "NFKD",
            valor_unicode
        )
        return valor_normalizado.encode(
            "ascii",
            "ignore"
        )
    except Exception:
        try:
            return valor_unicode.encode(
                "ascii",
                "ignore"
            )
        except Exception:
            return str(valor_unicode)

# Normalizacion de texto y nombres


def texto_unicode(valor):
    if valor is None:
        return u""
    try:
        unicode_type = unicode
    except NameError:
        unicode_type = str

    if isinstance(valor, unicode_type):
        return valor

    if isinstance(valor, str):
        try:
            return valor.decode("utf-8")
        except Exception:
            try:
                return valor.decode("cp1252")
            except Exception:
                return unicode_type(valor, errors="replace")

    try:
        return unicode_type(valor)
    except Exception:
        return u""

# FUNCIONES AUXILIARES GENERALES


def msg(texto):
    arcpy.AddMessage(
        texto_unicode(texto)
    )


def warn(texto):
    arcpy.AddWarning(
        texto_unicode(texto)
    )


def error(texto):
    arcpy.AddError(
        texto_unicode(texto)
    )


def normalizar_texto(texto):
    valor = texto_unicode(texto).lower().strip()

    reparaciones = {}

    for origen, destino in reparaciones.items():
        valor = valor.replace(
            origen.lower(),
            destino
        )

    try:
        valor_descompuesto = unicodedata.normalize(
            "NFKD",
            valor
        )

        valor = u"".join(
            caracter
            for caracter in valor_descompuesto
            if not unicodedata.combining(
                caracter
            )
        )
    except Exception:
        pass

    limpio = []

    for caracter in valor:
        if caracter.isalnum():
            limpio.append(caracter)
        else:
            limpio.append(u" ")

    return u" ".join(
        u"".join(limpio).split()
    )


def nombre_seguro(nombre, alternativo="SALIDA"):
    valor = normalizar_texto(nombre)

    valor = re.sub(
        ur"[^a-zA-Z0-9_]+",
        "_",
        valor
    )

    valor = re.sub(
        ur"_+",
        "_",
        valor
    ).strip("_")

    if not valor:
        valor = alternativo

    if valor[0].isdigit():
        valor = "N_" + valor

    return valor[:55]


def borrar(ruta):
    if ruta and arcpy.Exists(ruta):
        arcpy.Delete_management(ruta)


def campo_real(tabla, nombre_buscado):
    objetivo = normalizar_texto(
        nombre_buscado
    ).replace(" ", "")

    campos_disponibles = []

    for campo in arcpy.ListFields(tabla):
        campos_disponibles.append(
            campo.name
        )

        clave = normalizar_texto(
            campo.name
        ).replace(" ", "")

        if clave == objetivo:
            return campo.name

    raise RuntimeError(
        u"No se encontro el campo '{0}' en '{1}'. "
        u"Campos disponibles: {2}".format(
            texto_unicode(nombre_buscado),
            texto_unicode(tabla),
            u", ".join(
                texto_unicode(nombre)
                for nombre in campos_disponibles
            )
        )
    )


def clasificar_organico_directo(nombre):
    bruto = texto_unicode(nombre).lower()

    for separador in [
        u"-", u"_", u"/", u"\\", u",", u";",
        u":", u".", u"(", u")", u"[", u"]"
    ]:
        bruto = bruto.replace(
            separador,
            u" "
        )

    bruto = u" ".join(
        bruto.split()
    )

    es_organico = (
        u"org" in bruto or
        u"vegetal" in bruto
    )

    if not es_organico:
        return None

    return "material organico"

# Cache para no releer la capa de agua en cada seccion.
_CACHE_CAPAS_AGUA = {}


def _clave_capa(capa):
    try:
        descripcion = arcpy.Describe(capa)
        return texto_unicode(
            getattr(descripcion, "catalogPath", capa)
        )
    except Exception:
        return texto_unicode(capa)


def _extensiones_intersectan(ext1, ext2):
    try:
        return not (
            ext1.XMax < ext2.XMin or
            ext1.XMin > ext2.XMax or
            ext1.YMax < ext2.YMin or
            ext1.YMin > ext2.YMax
        )
    except Exception:
        return True


def _geometrias_agua(capa_agua):
    if not capa_agua:
        return []

    clave = _clave_capa(capa_agua)

    if clave in _CACHE_CAPAS_AGUA:
        return _CACHE_CAPAS_AGUA[clave]

    registros = []

    try:
        with arcpy.da.SearchCursor(
            capa_agua,
            ["SHAPE@"]
        ) as cursor:
            for fila in cursor:
                geometria = fila[0]

                if geometria is None:
                    continue

                try:
                    extension = geometria.extent
                except Exception:
                    extension = None

                registros.append(
                    (geometria, extension)
                )
    except Exception as exc:
        arcpy.AddWarning(
            "No fue posible leer la capa de agua: {0}".format(
                exc
            )
        )

    _CACHE_CAPAS_AGUA[clave] = registros
    return registros

# Geometria y cuerpos de agua


def _mascara_agua_linea(
    capa_agua,
    linea,
    grid_x,
    mensaje=None
):
    """
    Localiza todos los cuerpos de agua que cruzan la seccion.
    Primero usa interseccion geometrica y, si ArcGIS no devuelve
    un tramo valido, revisa los puntos ya existentes del perfil.
    """
    mascara = [False for _ in grid_x]

    if not capa_agua or linea is None or not grid_x:
        return mascara

    registros = _geometrias_agua(capa_agua)

    if not registros:
        if mensaje:
            mensaje("La capa de agua no contiene geometria valida.")
        return mascara

    try:
        sr_linea = linea.spatialReference
        extension_linea = linea.extent
    except Exception:
        sr_linea = None
        extension_linea = None

    try:
        descripcion = arcpy.Describe(capa_agua)
        tipo_agua = texto_unicode(
            getattr(descripcion, "shapeType", "")
        ).lower()
    except Exception:
        tipo_agua = ""

    paso_grid = (
        abs(grid_x[1] - grid_x[0])
        if len(grid_x) > 1
        else 1.0
    )

    # Los puntos del perfil se calculan una sola vez. Esto evita ciclos
    # costosos por cada poligono del shapefile.
    puntos_perfil = []

    for distancia in grid_x:
        try:
            puntos_perfil.append(
                linea.positionAlongLine(
                    float(distancia),
                    False
                )
            )
        except Exception:
            puntos_perfil.append(None)

    intervalos = []

    for geometria, extension in registros:
        if geometria is None:
            continue

        if (
            extension_linea is not None and
            extension is not None and
            not _extensiones_intersectan(
                extension_linea,
                extension
            )
        ):
            continue

        geometria_local = geometria

        try:
            sr_agua = geometria.spatialReference

            if (
                sr_linea is not None and
                sr_agua is not None and
                getattr(sr_linea, "factoryCode", 0) !=
                getattr(sr_agua, "factoryCode", 0)
            ):
                geometria_local = geometria.projectAs(
                    sr_linea
                )
        except Exception:
            pass

        # Las capas lineales reciben un ancho cartografico minimo.
        if "polyline" in tipo_agua or tipo_agua == "line":
            try:
                geometria_local = geometria_local.buffer(
                    20.0
                )
            except Exception:
                pass

        try:
            if geometria_local.disjoint(linea):
                continue
        except Exception:
            continue

        distancias = []

        # Intento principal: tramo lineal contenido en el cuerpo de agua.
        try:
            interseccion = linea.intersect(
                geometria_local,
                2
            )
        except Exception:
            interseccion = None

        if (
            interseccion is not None and
            not getattr(interseccion, "isEmpty", True)
        ):
            try:
                for parte in interseccion:
                    for punto in parte:
                        if punto is None:
                            continue

                        punto_geom = arcpy.PointGeometry(
                            arcpy.Point(punto.X, punto.Y),
                            sr_linea
                        )
                        distancias.append(
                            float(
                                linea.measureOnLine(
                                    punto_geom,
                                    False
                                )
                            )
                        )
            except Exception:
                distancias = []

        # Respaldo limitado: se evalua cada muestra del perfil una vez.
        if not distancias:
            indices_dentro = []

            for indice, punto_perfil in enumerate(
                puntos_perfil
            ):
                if punto_perfil is None:
                    continue

                try:
                    dentro = not geometria_local.disjoint(
                        punto_perfil
                    )
                except Exception:
                    dentro = False

                if dentro:
                    indices_dentro.append(indice)

            if indices_dentro:
                distancias = [
                    float(grid_x[min(indices_dentro)]),
                    float(grid_x[max(indices_dentro)])
                ]

        if not distancias:
            continue

        inicio = min(distancias)
        fin = max(distancias)

        # Todo cuerpo pequeno conserva al menos tres muestras visibles.
        if abs(fin - inicio) < 2.0 * paso_grid:
            centro = (inicio + fin) / 2.0
            inicio = centro - paso_grid
            fin = centro + paso_grid

        intervalos.append((inicio, fin))

    if not intervalos:
        if mensaje:
            mensaje(
                "No se detectaron cruces con la capa de agua."
            )
        return mascara

    intervalos.sort(key=lambda valor: valor[0])
    intervalos_unidos = []

    for inicio, fin in intervalos:
        inicio = max(min(grid_x), inicio)
        fin = min(max(grid_x), fin)

        if fin < inicio:
            inicio, fin = fin, inicio

        if (
            intervalos_unidos and
            inicio <= intervalos_unidos[-1][1] + paso_grid
        ):
            intervalos_unidos[-1] = (
                intervalos_unidos[-1][0],
                max(intervalos_unidos[-1][1], fin)
            )
        else:
            intervalos_unidos.append((inicio, fin))

    for inicio, fin in intervalos_unidos:
        indices = [
            indice
            for indice, distancia in enumerate(grid_x)
            if inicio <= distancia <= fin
        ]

        if not indices:
            centro = (inicio + fin) / 2.0
            indices = [
                min(
                    range(len(grid_x)),
                    key=lambda indice: abs(
                        grid_x[indice] - centro
                    )
                )
            ]

        for indice in indices:
            mascara[indice] = True

    if mensaje:
        mensaje(
            "Agua incorporada: {0} tramo(s), {1} muestras."
            .format(
                len(intervalos_unidos),
                sum(1 for valor in mascara if valor)
            )
        )

    return mascara


# Nivel freatico


def _campo_real_simple(capa, nombre):
    if not capa or not nombre:
        return None

    objetivo = normalizar_texto(nombre)

    try:
        for campo in arcpy.ListFields(capa):
            if normalizar_texto(campo.name) == objetivo:
                return campo.name
            if normalizar_texto(campo.aliasName) == objetivo:
                return campo.name
    except Exception:
        return None

    return None


def _controles_nivel_freatico(
    capa_puntos,
    campo_profundidad,
    linea,
    radio_proyeccion,
    mensaje=None
):
    """
    Proyecta mediciones de profundidad al nivel freatico sobre la seccion.
    La profundidad se interpreta en metros bajo la superficie del punto.
    """
    controles = []

    if not capa_puntos or not campo_profundidad or linea is None:
        return controles

    campo_real = _campo_real_simple(
        capa_puntos,
        campo_profundidad
    )

    if not campo_real:
        if mensaje:
            mensaje(
                "No se encontro el campo de nivel freatico: {0}."
                .format(campo_profundidad)
            )
        return controles

    try:
        with arcpy.da.SearchCursor(
            capa_puntos,
            ["SHAPE@", campo_real]
        ) as cursor:
            for geometria, valor in cursor:
                if geometria is None or valor is None:
                    continue

                try:
                    profundidad = float(valor)
                except Exception:
                    continue

                if profundidad < 0.0:
                    continue

                try:
                    consulta = linea.queryPointAndDistance(
                        geometria,
                        False
                    )
                    distancia = float(consulta[1])
                    offset = float(consulta[2])
                except Exception:
                    continue

                if offset > float(radio_proyeccion):
                    continue

                controles.append(
                    {
                        "x": distancia,
                        "profundidad": profundidad,
                        "offset": offset
                    }
                )
    except Exception as exc:
        if mensaje:
            mensaje(
                "No fue posible leer los controles de nivel freatico: {0}"
                .format(exc)
            )
        return []

    controles.sort(key=lambda item: item["x"])

    if mensaje and controles:
        mensaje(
            "Controles de nivel freatico utilizados: {0}."
            .format(len(controles))
        )

    return controles


def _influencia_mascara(grid_x, mascara, alcance):
    """Devuelve una influencia 0-1 que disminuye con la distancia."""
    resultado = [0.0 for _ in grid_x]

    if not grid_x or not mascara or alcance <= 0.0:
        return resultado

    posiciones = [
        grid_x[i]
        for i, activo in enumerate(mascara)
        if activo
    ]

    if not posiciones:
        return resultado

    for i, x in enumerate(grid_x):
        distancia = min(
            abs(float(x) - float(x_control))
            for x_control in posiciones
        )

        if distancia >= alcance:
            continue

        t = 1.0 - distancia / float(alcance)
        resultado[i] = t * t * (3.0 - 2.0 * t)

    return resultado


def _suavizar_nivel_freatico(valores, iteraciones):
    if not valores or len(valores) < 3:
        return list(valores)

    salida = list(valores)

    for _ in range(max(0, int(iteraciones))):
        nueva = list(salida)

        for i in range(1, len(salida) - 1):
            if (
                salida[i - 1] != salida[i - 1] or
                salida[i] != salida[i] or
                salida[i + 1] != salida[i + 1]
            ):
                continue

            nueva[i] = (
                0.25 * salida[i - 1] +
                0.50 * salida[i] +
                0.25 * salida[i + 1]
            )

        salida = nueva

    return salida


def _indice_hidro_litologico(espesores_grid, unidades, indice):
    """
    Calcula un modificador secundario a partir de la proporcion relativa
    de materiales gruesos y finos. No sustituye la carga hidraulica regional.
    """
    gruesos = 0.0
    finos = 0.0
    total = 0.0

    for estilo in unidades:
        try:
            espesor = max(
                0.0,
                float(espesores_grid[estilo][indice])
            )
        except Exception:
            continue

        if espesor <= 0.0:
            continue

        clave = normalizar_texto(estilo)
        total += espesor

        if (
            "arena" in clave or
            "grava" in clave or
            "conglomer" in clave or
            "duna" in clave or
            "arena roja" in clave
        ):
            gruesos += espesor
        elif (
            "arcilla" in clave or
            "lutita" in clave or
            "limolita" in clave or
            "marga" in clave
        ):
            finos += espesor

    if total <= 0.0:
        return 1.0

    fraccion_gruesa = gruesos / total
    fraccion_fina = finos / total

    # Los materiales finos favorecen niveles someros en planicies y
    # los materiales gruesos permiten mayor drenaje vertical. El efecto
    # se mantiene pequeno para no imponer la litologia sobre la piezometria.
    return max(
        0.92,
        min(
            1.10,
            1.0 +
            0.10 * fraccion_gruesa -
            0.08 * fraccion_fina
        )
    )


def _calcular_nivel_freatico(
    linea,
    grid_x,
    terreno,
    espesores_grid,
    unidades_geologicas,
    mascara_agua,
    radio_proyeccion,
    mensaje=None
):
    """
    Modelo conceptual del nivel freatico para la Costera de Coatzacoalcos.

    Prioridad:
      1) controles medidos;
      2) cuerpos de agua y zonas humedas/inundables;
      3) relieve;
      4) litologia como modificador secundario.
    """
    if not CONFIG_PROYECTO.get("mostrar_nivel_freatico", True):
        return None

    if not grid_x or not terreno:
        return None

    metodo = normalizar_texto(
        CONFIG_PROYECTO.get(
            "metodo_nivel_freatico",
            "hibrido"
        )
    )

    capa_puntos = CONFIG_PROYECTO.get("puntos_nivel_freatico")
    campo_nivel = CONFIG_PROYECTO.get("campo_nivel_freatico")

    controles = _controles_nivel_freatico(
        capa_puntos,
        campo_nivel,
        linea,
        radio_proyeccion,
        mensaje
    )

    if metodo == "solo observado" and not controles:
        if mensaje:
            mensaje(
                "Nivel freatico omitido: el modo Solo observado requiere "
                "puntos y un campo de profundidad."
            )
        return None

    z_min = min(float(valor) for valor in terreno)
    z_max = max(float(valor) for valor in terreno)
    rango_relieve = max(1.0, z_max - z_min)

    profundidades = []

    for i, z in enumerate(terreno):
        z = float(z)
        posicion_relativa = max(
            0.0,
            min(1.0, (z - z_min) / rango_relieve)
        )

        # El estudio regional reporta desde niveles centimetrico-someros
        # junto a drenajes/costa hasta aproximadamente 35-45 m en lomerios.
        # Superficie regional: cerca de planicies bajas se mantiene somera,
        # mientras que en lomerios y terrenos elevados puede alcanzar los
        # rangos regionales de 25-35 m observados para el acuifero.
        profundidad = (
            0.50 +
            0.52 * max(0.0, z) +
            12.0 * math.pow(posicion_relativa, 1.35)
        )
        profundidad = max(0.15, min(45.0, profundidad))

        profundidad *= _indice_hidro_litologico(
            espesores_grid,
            unidades_geologicas,
            i
        )

        profundidades.append(
            max(0.10, min(45.0, profundidad))
        )

    mascara_humedales = _mascara_agua_linea(
        CONFIG_PROYECTO.get("humedales_nivel_freatico"),
        linea,
        grid_x
    )
    mascara_inundable = _mascara_agua_linea(
        CONFIG_PROYECTO.get("inundable_nivel_freatico"),
        linea,
        grid_x
    )
    mascara_escorrentias = _mascara_agua_linea(
        CONFIG_PROYECTO.get("escorrentias_nivel_freatico"),
        linea,
        grid_x
    )

    influencias = [
        (
            _influencia_mascara(
                grid_x,
                mascara_agua,
                2500.0
            ),
            0.25,
            0.95
        ),
        (
            _influencia_mascara(
                grid_x,
                mascara_humedales,
                1800.0
            ),
            1.00,
            0.85
        ),
        (
            _influencia_mascara(
                grid_x,
                mascara_inundable,
                2200.0
            ),
            3.00,
            0.72
        ),
        (
            _influencia_mascara(
                grid_x,
                mascara_escorrentias,
                1200.0
            ),
            2.50,
            0.45
        )
    ]

    if metodo != "solo observado":
        for influencia, objetivo, peso_maximo in influencias:
            for i in range(len(profundidades)):
                peso = max(
                    0.0,
                    min(
                        peso_maximo,
                        influencia[i] * peso_maximo
                    )
                )

                profundidades[i] = (
                    profundidades[i] * (1.0 - peso) +
                    objetivo * peso
                )

    elevaciones_estimadas = [
        float(terreno[i]) - profundidades[i]
        for i in range(len(grid_x))
    ]

    # Controles observados: la interpolacion se realiza sobre elevacion
    # hidraulica y no directamente sobre profundidad.
    controles_h = []

    for control in controles:
        x_control = control["x"]

        if x_control < min(grid_x) or x_control > max(grid_x):
            continue

        # Interpolacion lineal simple de la topografia al control.
        indice_cercano = min(
            range(len(grid_x)),
            key=lambda i: abs(grid_x[i] - x_control)
        )
        z_control = float(terreno[indice_cercano])
        h_control = z_control - float(control["profundidad"])

        controles_h.append(
            {
                "x": x_control,
                "h": h_control,
                "profundidad": float(control["profundidad"])
            }
        )

    if controles_h:
        elevaciones_observadas = []
        distancia_minima = []

        for x in grid_x:
            pesos = []
            numerador = 0.0
            denominador = 0.0
            d_min = None

            for control in controles_h:
                distancia = abs(float(x) - float(control["x"]))
                d_min = (
                    distancia
                    if d_min is None
                    else min(d_min, distancia)
                )
                peso = 1.0 / math.pow(distancia + 50.0, 2.0)
                numerador += control["h"] * peso
                denominador += peso
                pesos.append(peso)

            elevaciones_observadas.append(
                numerador / denominador
                if denominador > 0.0
                else float("nan")
            )
            distancia_minima.append(
                999999.0 if d_min is None else d_min
            )

        if metodo == "solo observado":
            if len(controles_h) >= 2:
                x_min_obs = min(c["x"] for c in controles_h)
                x_max_obs = max(c["x"] for c in controles_h)
                elevaciones_estimadas = [
                    (
                        elevaciones_observadas[i]
                        if x_min_obs <= grid_x[i] <= x_max_obs
                        else float("nan")
                    )
                    for i in range(len(grid_x))
                ]
            else:
                x_unico = controles_h[0]["x"]
                elevaciones_estimadas = [
                    (
                        elevaciones_observadas[i]
                        if abs(grid_x[i] - x_unico) <= 500.0
                        else float("nan")
                    )
                    for i in range(len(grid_x))
                ]
        elif metodo == "hibrido":
            for i in range(len(grid_x)):
                peso_obs = math.exp(
                    -distancia_minima[i] / 6000.0
                )
                peso_obs = max(0.0, min(1.0, peso_obs))
                elevaciones_estimadas[i] = (
                    elevaciones_estimadas[i] * (1.0 - peso_obs) +
                    elevaciones_observadas[i] * peso_obs
                )

    elif metodo == "hibrido" and mensaje:
        mensaje(
            "Nivel freatico Hibrido sin controles medidos: se utilizara "
            "el modelo regional estimado."
        )

    suavizado = normalizar_texto(
        CONFIG_PROYECTO.get(
            "suavizado_nivel_freatico",
            "medio"
        )
    )
    iteraciones = {
        "bajo": 2,
        "medio": 6,
        "alto": 12
    }.get(suavizado, 6)

    elevaciones_estimadas = _suavizar_nivel_freatico(
        elevaciones_estimadas,
        iteraciones
    )

    # Restricciones fisicas y reanclaje de observaciones.
    for i in range(len(grid_x)):
        h = elevaciones_estimadas[i]

        if h != h:
            continue

        techo = float(terreno[i]) - 0.05
        piso = float(terreno[i]) - 45.0
        elevaciones_estimadas[i] = max(
            piso,
            min(techo, h)
        )

    for control in controles_h:
        indice = min(
            range(len(grid_x)),
            key=lambda i: abs(grid_x[i] - control["x"])
        )
        elevaciones_estimadas[indice] = min(
            float(terreno[indice]) - 0.01,
            control["h"]
        )

    if mensaje:
        validos = [
            valor
            for valor in elevaciones_estimadas
            if valor == valor
        ]

        if validos:
            profundidades_validas = [
                float(terreno[i]) - elevaciones_estimadas[i]
                for i in range(len(grid_x))
                if elevaciones_estimadas[i] == elevaciones_estimadas[i]
            ]
            mensaje(
                "Nivel freatico calculado: profundidad {0:.2f}-{1:.2f} m; "
                "metodo {2}."
                .format(
                    min(profundidades_validas),
                    max(profundidades_validas),
                    metodo.title()
                )
            )

    return {
        "elevaciones": elevaciones_estimadas,
        "controles": controles_h,
        "metodo": metodo
    }


def _dibujar_nivel_freatico(
    ax,
    linea,
    grid_x,
    terreno,
    terreno_y,
    espesores_grid,
    unidades_geologicas,
    mascara_agua,
    base_horizontal,
    ev,
    radio_proyeccion,
    profundidad_visible,
    mensaje=None
):
    resultado = _calcular_nivel_freatico(
        linea,
        grid_x,
        terreno,
        espesores_grid,
        unidades_geologicas,
        mascara_agua,
        radio_proyeccion,
        mensaje
    )

    if not resultado:
        return False

    elevaciones = resultado["elevaciones"]
    y_nf_superior = []
    y_nf_inferior = []
    margen_estacional = 5.0

    for i in range(len(grid_x)):
        elevacion_nf = elevaciones[i]

        if elevacion_nf != elevacion_nf:
            y_nf_superior.append(float("nan"))
            y_nf_inferior.append(float("nan"))
            continue

        profundidad_nf = (
            float(terreno[i]) -
            float(elevacion_nf)
        )
        profundidad_nf_inferior = (
            profundidad_nf + margen_estacional
        )

        if (
            profundidad_visible is not None and
            profundidad_nf > float(profundidad_visible)
        ):
            y_nf_superior.append(float("nan"))
        else:
            y_nf_superior.append(
                (elevacion_nf - base_horizontal) * ev
            )

        if (
            profundidad_visible is not None and
            profundidad_nf_inferior > float(profundidad_visible)
        ):
            y_nf_inferior.append(float("nan"))
        else:
            y_nf_inferior.append(
                (
                    elevacion_nf -
                    margen_estacional -
                    base_horizontal
                ) * ev
            )

    # Linea superior: limite estacional alto, representado como punteado.
    # Linea inferior: referencia conservadora 5 m abajo, representada continua.
    ax.plot(
        grid_x,
        y_nf_superior,
        color="#176FA6",
        linewidth=1.25,
        linestyle="--",
        zorder=23
    )

    ax.plot(
        grid_x,
        y_nf_inferior,
        color="#176FA6",
        linewidth=1.55,
        linestyle="-",
        zorder=24
    )

    for control in resultado["controles"]:
        indice = min(
            range(len(grid_x)),
            key=lambda i: abs(grid_x[i] - control["x"])
        )
        y_control = y_nf_superior[indice]

        if y_control != y_control:
            continue

        ax.plot(
            [grid_x[indice]],
            [y_control],
            marker="v",
            markersize=4.5,
            markerfacecolor="#176FA6",
            markeredgecolor="#0B4568",
            markeredgewidth=0.5,
            linestyle="None",
            zorder=25
        )

    if mensaje:
        mensaje(
            "Nivel freatico representado como rango estacional de 5 m."
        )

    return True


