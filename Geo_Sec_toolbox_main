        def registrar_litologia_nueva(nombre_original):
            """
            Registra automaticamente una litologia no contemplada en el
            catalogo inicial. La clave, el color y la trama son estables:
            el mismo nombre recibira la misma simbologia en todas las
            secciones del proyecto.
            """
            etiqueta = texto_unicode(
                nombre_original
            ).strip()

            if not etiqueta:
                return "otro"

            clave_normal = normalizar(etiqueta)

            if not clave_normal:
                return "otro"

            clave_dinamica = "litologia nueva " + clave_normal

            if clave_dinamica in ESTILOS_LITOLOGIA:
                return clave_dinamica

            colores_dinamicos = [
                "#6FA8A5",
                "#B58B5A",
                "#8C78A8",
                "#7E9B65",
                "#C27A72",
                "#6E8EAD",
                "#A59B5C",
                "#9A6F84",
                "#73958A",
                "#B47D4F",
                "#7B87A6",
                "#8A9D72"
            ]

            tramas_dinamicas = [
                "//",
                "\\\\",
                "xx",
                "++",
                "..",
                "oo"
            ]

            semilla = 0

            for indice_caracter, caracter in enumerate(
                clave_normal
            ):
                semilla += (
                    (indice_caracter + 1) *
                    ord(caracter)
                )

            indice_color = (
                semilla % len(colores_dinamicos)
            )
            indice_trama = (
                semilla % len(tramas_dinamicas)
            )

            etiqueta_visible = u" ".join(
                palabra.capitalize()
                for palabra in clave_normal.split()
            )

            ESTILOS_LITOLOGIA[clave_dinamica] = {
                "etiqueta": etiqueta_visible,
                "color": colores_dinamicos[indice_color],
                "trama": tramas_dinamicas[indice_trama],
                "dinamica": True,
                "nombre_original": etiqueta
            }

            msg_local(
                "Nueva litologia incorporada: {0} | color {1}"
                .format(
                    etiqueta_visible,
                    colores_dinamicos[indice_color]
                )
            )

            return clave_dinamica

        def campo_real_local(tabla, nombre_buscado):
            """
            Devuelve el nombre real de un campo, ignorando mayusculas,
            minusculas, acentos, espacios y guiones bajos.

            Lanza un error claro cuando el campo no existe.
            """
            objetivo = normalizar(
                nombre_buscado
            ).replace(" ", "")

            coincidencias = []

            for campo in arcpy.ListFields(tabla):
                clave = normalizar(
                    campo.name
                ).replace(" ", "")

                if clave == objetivo:
                    return campo.name

                coincidencias.append(
                    campo.name
                )

            raise RuntimeError(
                u"No se encontro el campo '{0}' en '{1}'. "
                u"Campos disponibles: {2}".format(
                    texto_unicode(nombre_buscado),
                    texto_unicode(tabla),
                    u", ".join(
                        texto_unicode(nombre)
                        for nombre in coincidencias
                    )
                )
            )

        def buscar_campo(capa, candidatos):
            if not capa:
                return None

            campos = [
                campo.name for campo in arcpy.ListFields(capa)
            ]
            mapa = {
                normalizar(nombre): nombre
                for nombre in campos
            }

            for candidato in candidatos:
                clave = normalizar(candidato)
                if clave in mapa:
                    return mapa[clave]

            return None

        def leer_unidad_regional_en_punto(capa, punto):
            """
            Devuelve atributos de la unidad geologica regional que contiene
            al punto. Esta informacion solo se usa como apoyo para basamento
            y continuidad regional; nunca sustituye los intervalos de sondeo.
            """
            if not capa:
                return None

            campo_lito = buscar_campo(
                capa,
                ["LITOLOGIA", "LITOLOGIA"]
            )
            campo_roca = buscar_campo(
                capa,
                ["ROCA"]
            )
            campo_clave = buscar_campo(
                capa,
                ["CLAVE", "CLAVE_SGM"]
            )
            campo_formacion = buscar_campo(
                capa,
                ["FORMACION", "FORMACION"]
            )
            campo_objeto = buscar_campo(
                capa,
                ["O_ESPACIAL", "OBJETO_ESPACIAL"]
            )

            campos = ["SHAPE@"]
            campos_extra = []

            for campo in [
                campo_lito,
                campo_roca,
                campo_clave,
                campo_formacion,
                campo_objeto
            ]:
                if campo and campo not in campos_extra:
                    campos_extra.append(campo)

            campos.extend(campos_extra)

            with arcpy.da.SearchCursor(
                capa,
                campos
            ) as cursor:
                for fila in cursor:
                    geometria = fila[0]

                    try:
                        contiene = geometria.contains(punto)
                    except Exception:
                        contiene = False

                    if not contiene:
                        continue

                    atributos = {}

                    for indice, campo in enumerate(
                        campos_extra,
                        start=1
                    ):
                        atributos[campo] = fila[indice]

                    return {
                        "litologia": atributos.get(
                            campo_lito,
                            ""
                        ) if campo_lito else "",
                        "roca": atributos.get(
                            campo_roca,
                            ""
                        ) if campo_roca else "",
                        "clave": atributos.get(
                            campo_clave,
                            ""
                        ) if campo_clave else "",
                        "formacion": atributos.get(
                            campo_formacion,
                            ""
                        ) if campo_formacion else "",
                        "objeto": atributos.get(
                            campo_objeto,
                            ""
                        ) if campo_objeto else ""
                    }

            return None

