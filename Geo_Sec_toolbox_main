            u'<col min="2" max="2" width="16" customWidth="1"/>'
            u'<col min="3" max="3" width="16" customWidth="1"/>'
            u'<col min="4" max="14" width="12" customWidth="1"/></cols>'
            u'<sheetData>{0}</sheetData>{1}</worksheet>'
        ).format(
            u"".join(xml_filas),
            dibujo
        )

    hojas_resumen = []

    for nombre_banda, etiquetas, valores in resumenes:
        total = sum(valores)
        filas = [["Litologia", "Total (m)", "Porcentaje"]]

        for etiqueta, valor in zip(etiquetas, valores):
            porcentaje = (
                100.0 * float(valor) / float(total)
