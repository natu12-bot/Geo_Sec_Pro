                        )
                        continue

                    nombre_litologia = texto_unicode(fila[3]).strip()

                    if not nombre_litologia:
                        warn_local(
                            "Fila {0} omitida: LITOLOGIA vacia.".format(
                                filas_leidas
                            )
                        )
                        continue

                    litologia.setdefault(sid, []).append({
                        "desde": desde,
                        "hasta": hasta,
                        "unidad": clasificar_litologia(nombre_litologia),
                        "litologia": nombre_litologia
                    })

                    filas_validas += 1

            msg_local(
                "Filas leidas de litologia: {0}; filas validas: {1}".format(
                    filas_leidas,
                    filas_validas
                )
            )

            try:
                borrar_local(tabla_temporal)
            except Exception:
                pass

            for sid in litologia:
                litologia[sid] = sorted(
                    litologia[sid],
                    key=lambda r: r["desde"]
                )

            msg_local("Proyectando sondeos...")

            fson = campo_real_local(
                sondeos_z,
                CAMPO_SONDEO
            )

            fprof = campo_real_local(
                sondeos_z,
                CAMPO_PROF_TOTAL
            )

            # La elevacion de boca puede venir con distintos nombres,
            # desde la geometria Z o desde el perfil topografico.
            felev = buscar_campo(
                sondeos_z,
                [
                    CAMPO_ELEV_BOCA,
                    "ELEVACION",
                    "ELEV",
                    "Z",
                    "COTA",
                    "ALTITUD",
                    "MSNM",
                    "ELEV_M"
                ]
            )

            campos_sondeos = [
                "SHAPE@",
                fson,
                fprof
            ]

            if felev:
                campos_sondeos.append(felev)
                msg_local(
                    "Elevacion de sondeos tomada del campo: {0}."
                    .format(felev)
                )
            else:
                msg_local(
                    "La capa no contiene campo de elevacion. "
                    "Se intentara usar Z geometrico y, como respaldo, "
                    "el perfil topografico."
                )

            datos = {}

            with arcpy.da.SearchCursor(
                sondeos_z,
                campos_sondeos
            ) as cursor:
                for fila_sondeo in cursor:
                    geom = fila_sondeo[0]
                    sid0 = fila_sondeo[1]
                    prof0 = fila_sondeo[2]
                    elev0 = (
                        fila_sondeo[3]
                        if felev and len(fila_sondeo) > 3
                        else None
                    )

                    sid_original = texto_unicode(sid0).strip()
                    sid = clave_sondeo(sid_original)

                    if not sid or prof0 is None or geom is None:
                        continue

                    consulta = linea.queryPointAndDistance(
                        geom,
                        False
                    )

                    distancia_proyectada = float(
                        consulta[1]
                    )
                    offset = float(consulta[2])

                    if offset > radio:
                        warn_local(
                            u"{0} omitido: {1:.1f} m fuera de la seccion.".format(
                                nombre_sondeo(sid_original),
                                offset
                            )
                        )
                        continue

                    elevacion_directa = None
                    fuente_elevacion = "perfil"

                    if elev0 is not None:
                        try:
                            valor_elevacion = float(elev0)
                            if valor_elevacion == valor_elevacion:
                                elevacion_directa = valor_elevacion
                                fuente_elevacion = "campo"
                        except Exception:
                            pass

                    if elevacion_directa is None:
                        try:
                            punto_z = geom.firstPoint
                            valor_z = float(punto_z.Z)
                            if valor_z == valor_z:
                                elevacion_directa = valor_z
                                fuente_elevacion = "geometria_z"
                        except Exception:
                            pass

                    if elevacion_directa is None:
                        elevacion_directa = interpolar_lineal(
                            perfil_x,
                            perfil_z,
                            distancia_proyectada
                        )
                        fuente_elevacion = "perfil"

                    datos[sid] = {
                        "nombre": nombre_sondeo(sid_original),
                        "distancia": distancia_proyectada,
                        "offset": offset,
                        "profundidad": float(prof0),
                        "elevacion": float(elevacion_directa),
                        "elevacion_directa": (
                            fuente_elevacion in (
                                "campo",
                                "geometria_z"
                            )
                        ),
                        "fuente_elevacion": fuente_elevacion,
                        "geom": geom
                    }

            if len(datos) < 2:
                raise RuntimeError(
                    "Se requieren al menos dos sondeos dentro del radio."
                )

            coincidencias = [
                sid for sid in datos
                if sid in litologia and len(litologia[sid]) > 0
            ]

            if not coincidencias:
                claves_puntos = ", ".join(sorted(datos.keys()))
                claves_tabla = ", ".join(sorted(litologia.keys()))

                raise RuntimeError(
                    "No se vinculo ningun sondeo con la tabla litologica. "
                    "Filas leidas: {0}; filas validas: {1}. "
                    "Claves en puntos: [{2}]. Claves en tabla: [{3}]. "
                    "Revisa que el CSV tenga datos en SONDEO, DESDE_M, "
                    "HASTA_M y LITOLOGIA.".format(
                        filas_leidas,
                        filas_validas,
                        claves_puntos,
                        claves_tabla
                    )
                )

            sondeos_ordenados = sorted(
                datos.keys(),
                key=lambda sid: datos[sid]["distancia"]
            )

            controles = []

            for sid in sondeos_ordenados:
                cantidad_intervalos = len(litologia.get(sid, []))
                msg_local(
                    "{0}: {1} intervalos litologicos vinculados".format(
                        datos[sid]["nombre"],
                        cantidad_intervalos
                    )
                )
                intervalos = litologia.get(sid, [])

                base_cobertura = 0.0
                base_arena_fina = 0.0
                base_arena_gruesa = 0.0
                techo_lutita = None

                profundidad_observada = min(
                    datos[sid]["profundidad"],
                    max(
                        [i["hasta"] for i in intervalos]
                        if intervalos else
                        [datos[sid]["profundidad"]]
                    )
                )

                # Los contactos se obtienen directamente de los intervalos
                # observados, respetando su orden de profundidad.
                for intervalo in intervalos:
                    desde = max(0.0, intervalo["desde"])
                    hasta = min(
                        profundidad_observada,
                        intervalo["hasta"]
                    )

                    if hasta <= desde:
                        continue

                    unidad = intervalo["unidad"]

                    if unidad == "COBERTURA":
                        base_cobertura = max(
                            base_cobertura,
                            hasta
                        )

                    elif unidad == "ARENA_FINA":
                        base_arena_fina = max(
                            base_arena_fina,
                            hasta
                        )

                    elif unidad in ("ARENA_GRUESA", "ARENA"):
                        base_arena_gruesa = max(
                            base_arena_gruesa,
                            hasta
                        )

                    elif unidad == "LUTITA":
                        if techo_lutita is None:
                            techo_lutita = desde
                        else:
                            techo_lutita = min(
                                techo_lutita,
                                desde
                            )

                # Mantener orden estratigrafico.
                base_arena_fina = max(
                    base_cobertura,
                    base_arena_fina
                )

                base_arena_gruesa = max(
                    base_arena_fina,
                    base_arena_gruesa
                )

                # Si la lutita fue observada, su techo controla la base total
                # de la unidad arenosa. Si no fue observada, la arena conserva
                # el espesor descrito y la lutita se interpreta debajo.
                if techo_lutita is not None:
                    base_arena_gruesa = max(
                        base_arena_gruesa,
                        techo_lutita
                    )

                base_arena_gruesa = min(
                    base_arena_gruesa,
                    profundidad_observada
                )

                intervalos_exactos = []

                for intervalo in intervalos:
                    desde_exacto = max(
                        0.0,
                        float(intervalo["desde"])
                    )
                    hasta_exacto = min(
                        profundidad_observada,
                        float(intervalo["hasta"])
                    )

                    if hasta_exacto <= desde_exacto:
                        continue

                    nombre_intervalo = intervalo.get(
                        "litologia",
                        intervalo.get("unidad", "Otra litologia")
                    )

                    texto_crudo_intervalo = texto_unicode(
                        nombre_intervalo
                    )

                    clave_organica_directa = (
                        clasificar_organico_directo(
                            texto_crudo_intervalo
                        )
                    )

                    if clave_organica_directa:
                        clave_intervalo = (
                            clave_organica_directa
                        )
                    else:
                        clave_intervalo = (
                            clave_estilo_litologia(
                                texto_crudo_intervalo
                            )
                        )

                    # Garantia interna: las claves organicas deben
                    # existir en la simbologia y nunca convertirse a "otro".
                    if (
                        clave_intervalo ==
                        "material organico"
                    ):
                        nombre_intervalo = (
                            "Material organico"
                        )
                    elif (
                        clave_intervalo ==
                        "material organico"
                    ):
                        nombre_intervalo = (
                            "Material organico"
                        )
                    elif clave_intervalo == "lutita gris":
                        if normalizar(nombre_intervalo) == "lutita":
                            nombre_intervalo = "Lutita gris"

                    intervalos_exactos.append({
                        "desde": desde_exacto,
                        "hasta": hasta_exacto,
                        "litologia": nombre_intervalo,
                        "estilo": clave_intervalo
                    })

                    if (
                        clave_intervalo == "otro" and
                        not clasificar_organico_directo(
                            texto_crudo_intervalo
                        )
                    ):
                        texto_original_no_reconocido = texto_unicode(
                            intervalo.get(
                                "litologia",
                                intervalo.get(
                                    "unidad",
                                    ""
                                )
                            )
                        )

                        warn_local(
                            u"Litologia no reconocida en {0}: '{1}' "
                            u"(normalizada: '{2}'). Se representara como "
                            u"Otra litologia.".format(
                                datos[sid]["nombre"],
                                texto_original_no_reconocido,
                                normalizar(
                                    texto_original_no_reconocido
                                )
                            )
                        )

                controles.append({
                    "sid": datos[sid]["nombre"],
                    "clave": sid,
                    "x": datos[sid]["distancia"],
                    "elevacion": datos[sid]["elevacion"],
                    "elevacion_directa": datos[sid].get(
                        "elevacion_directa",
                        False
                    ),
                    "fuente_elevacion": datos[sid].get(
                        "fuente_elevacion",
                        "perfil"
                    ),
                    "profundidad": profundidad_observada,
                    "base_cobertura": base_cobertura,
                    "base_arena_fina": base_arena_fina,
                    "base_arena_gruesa": base_arena_gruesa,
                    "intervalos_exactos": intervalos_exactos,
                    "geom": datos[sid]["geom"]
                })

            control_x = [c["x"] for c in controles]

            fuentes_elevacion = {}

            for control_fuente in controles:
                fuente_local = control_fuente.get(
                    "fuente_elevacion",
                    "perfil"
                )
                fuentes_elevacion[fuente_local] = (
                    fuentes_elevacion.get(
                        fuente_local,
                        0
                    ) + 1
                )

            msg_local(
                "Fuentes de elevacion de sondeos: {0}."
                .format(
                    ", ".join(
                        "{0}={1}".format(
                            clave_fuente,
                            fuentes_elevacion[clave_fuente]
                        )
                        for clave_fuente in sorted(
                            fuentes_elevacion.keys()
                        )
                    )
                )
            )

            # Extender la interpretacion hasta los extremos reales A y A'
            # de la linea 3D. La funcion interpolar_lineal conserva el valor
            # del primer/ultimo sondeo fuera del intervalo observado, por lo
            # que la litologia continua lateralmente sin dejar espacios.
            x_inicio = perfil_x[0]
            x_fin = perfil_x[-1]

            # Distancia horizontal real de la linea 3D.
            factor_horizontal = 1.0
            longitud_real = max(
                x_fin - x_inicio,
                1.0
            )

            # En lote, longitud_escala_usuario contiene la barra
            # comun ya calculada. Se conserva sin limitarla ni volverla
            # a redondear para que todas las imagenes sean identicas.
            if longitud_escala_usuario > 0:
                longitud_escala = float(
                    longitud_escala_usuario
                )
            else:
                objetivo_escala = max(
                    longitud_real * 0.25,
                    1.0
                )

                exponente = math.floor(
                    math.log10(objetivo_escala)
                )
                base_escala = 10.0 ** exponente
                opciones_escala = [
                    1.0 * base_escala,
                    2.0 * base_escala,
                    5.0 * base_escala,
                    10.0 * base_escala
                ]

                longitud_escala = min(
                    opciones_escala,
                    key=lambda valor: abs(
                        valor - objetivo_escala
                    )
                )
                longitud_escala = min(
                    longitud_escala,
                    longitud_real
                )
                longitud_escala = _redondear_barra_grafica(
                    longitud_escala,
                    divisiones_escala,
                    longitud_real
                )

            msg_local(
                "Barra grafica aplicada: {0:.1f} m "
                "en {1} divisiones ({2})."
                .format(
                    longitud_escala,
                    divisiones_escala,
                    (
                        "comun del lote"
                        if longitud_escala_usuario > 0
                        else "automatica individual"
                    )
                )
            )

            if numero_muestras < 200:
                numero_muestras = 200

            paso = (
                (x_fin - x_inicio) /
                float(numero_muestras - 1)
            )

            grid_x = [
                x_inicio + i * paso
                for i in range(numero_muestras)
            ]

            terreno = [
                interpolar_lineal(
                    perfil_x,
                    perfil_z,
                    x
                )
                for x in grid_x
            ]

            terreno = _aplicar_suavizado_topografico(
                terreno,
                ventana
            )

            # Los sondeos de Factibilidad son controles topograficos directos.
            if controles and len(grid_x) > 1:
                paso_topografico = max(
                    abs(grid_x[1] - grid_x[0]),
                    0.01
                )

                controles_topograficos_directos = [
                    control_topo
                    for control_topo in controles
                    if control_topo.get(
                        "elevacion_directa",
                        False
                    )
                ]

                for indice_control_topo, control_topo in enumerate(
                    controles_topograficos_directos
                ):
                    x_control_topo = float(control_topo["x"])
                    z_control_topo = float(control_topo["elevacion"])
                    z_perfil_control = interpolar_lineal(
                        grid_x,
                        terreno,
                        x_control_topo
                    )
                    correccion_control = z_control_topo - z_perfil_control

                    distancias_vecinas_topo = []
                    if indice_control_topo > 0:
                        distancias_vecinas_topo.append(
                            abs(
                                x_control_topo -
                                controles_topograficos_directos[
                                    indice_control_topo - 1
                                ]["x"]
                            )
                        )

                    if (
                        indice_control_topo <
                        len(controles_topograficos_directos) - 1
                    ):
                        distancias_vecinas_topo.append(
                            abs(
                                controles_topograficos_directos[
                                    indice_control_topo + 1
                                ]["x"] -
                                x_control_topo
                            )
                        )

                    radio_anclaje_topo = (
                        max(
                            paso_topografico * 4.0,
                            min(distancias_vecinas_topo) * 0.10
                        )
                        if distancias_vecinas_topo
                        else paso_topografico * 6.0
                    )

                    for indice_grid_topo, x_grid_topo in enumerate(grid_x):
                        distancia_topo = abs(x_grid_topo - x_control_topo)
                        if distancia_topo > radio_anclaje_topo:
                            continue

                        fraccion_topo = max(
                            0.0,
                            1.0 - distancia_topo / float(radio_anclaje_topo)
                        )
                        peso_topo = (
                            fraccion_topo *
                            fraccion_topo *
                            fraccion_topo *
                            (
                                fraccion_topo *
                                (fraccion_topo * 6.0 - 15.0) +
                                10.0
                            )
                        )
                        terreno[indice_grid_topo] += (
                            correccion_control * peso_topo
                        )

                    indice_mas_cercano = min(
                        range(len(grid_x)),
                        key=lambda indice_local: abs(
                            grid_x[indice_local] - x_control_topo
                        )
                    )
                    terreno[indice_mas_cercano] = z_control_topo

                if controles_topograficos_directos:
                    msg_local(
                        "Perfil topografico anclado a {0} elevaciones "
                        "directas de sondeo."
                        .format(
                            len(controles_topograficos_directos)
                        )
                    )
                else:
                    msg_local(
                        "Sin elevaciones directas de sondeo: "
                        "se conserva el perfil topografico como referencia."
                    )

            def terreno_en_x(x):
                return interpolar_lineal(grid_x, terreno, x)

            controles_elevacion_perfil = 0

            for control_actualizar in controles:
                if not control_actualizar.get(
                    "elevacion_directa",
                    False
                ):
                    control_actualizar["elevacion"] = float(
                        terreno_en_x(
                            control_actualizar["x"]
                        )
                    )
                    control_actualizar[
                        "fuente_elevacion"
                    ] = "perfil_final"
                    controles_elevacion_perfil += 1

            if controles_elevacion_perfil:
                msg_local(
                    "{0} sondeos sin elevacion directa ajustados "
                    "al perfil topografico final."
                    .format(controles_elevacion_perfil)
                )

            base_horizontal_natural = (
                min(terreno) -
                metros_bajo_minimo
            )

            elevacion_superior_comun = CONFIG_PROYECTO.get(
                "elevacion_superior"
            )
            elevacion_inferior_comun = CONFIG_PROYECTO.get(
                "elevacion_inferior"
            )
            modo_vertical_motor = texto_unicode(
                CONFIG_PROYECTO.get(
                    "modo_vertical",
                    "automatica"
                )
            ).strip().lower()

            # Fijar la base vertical definitiva antes de transformar
            # cualquier elevacion a coordenadas graficas.
            if (
                modo_vertical_motor in (
                    "misma para todas",
                    "personalizada"
                ) and
                elevacion_superior_comun is not None and
                elevacion_inferior_comun is not None
            ):
                base_horizontal = float(
                    elevacion_inferior_comun
                )
            else:
                base_horizontal = float(
                    base_horizontal_natural
                )

            altura_marco_comun = float(
                CONFIG_PROYECTO.get(
                    "altura_marco",
                    max(10.0, max(terreno) - base_horizontal)
                )
            )

            msg_local(
                "Base vertical unica para dibujo y eje: "
                "{0:.1f} m s.n.m.".format(base_horizontal)
            )

            profundidad_grid_observada = [
                interpolar_lineal(
                    control_x,
                    [c["profundidad"] for c in controles],
                    x
                )
                for x in grid_x
            ]

            # La profundidad indicada define el limite vertical de interpretacion.
            profundidad_grid = [
                float(profundidad_interpretacion)
                for _ in profundidad_grid_observada
            ]

            if profundidad_interpretacion > 30.0:
                msg_local(
                    "Bajo 30 m se reduce la influencia directa del "
                    "barreno y domina la interpolacion circundante."
                )

            msg_local(
                "Profundidad efectiva de interpretacion: "
                "{0:.1f} m.".format(
                    profundidad_interpretacion
                )
            )
            if profundidad_interpretacion > 30.0:
                msg_local(
                    "Extension geologica activada hasta {0:.1f} m."
                    .format(profundidad_interpretacion)
                )

            cobertura_prof = [
                interpolar_lineal(
                    control_x,
                    [c["base_cobertura"] for c in controles],
                    x
                )
                for x in grid_x
            ]

            arena_fina_prof = [
                interpolar_lineal(
                    control_x,
                    [c["base_arena_fina"] for c in controles],
                    x
                )
                for x in grid_x
            ]

            arena_gruesa_prof = [
                interpolar_lineal(
                    control_x,
                    [c["base_arena_gruesa"] for c in controles],
                    x
                )
                for x in grid_x
            ]

            cobertura_prof = suavizar_contacto(
                cobertura_prof,
                iter_suavizado
            )

            arena_fina_prof = suavizar_contacto(
                arena_fina_prof,
                iter_suavizado
            )

            arena_gruesa_prof = suavizar_contacto(
                arena_gruesa_prof,
                iter_suavizado
            )

            for i in range(len(grid_x)):
                cobertura_prof[i] = max(
                    0.0,
                    min(
                        cobertura_prof[i],
                        profundidad_grid[i]
                    )
                )

                arena_fina_prof[i] = max(
                    cobertura_prof[i],
                    min(
                        arena_fina_prof[i],
                        profundidad_grid[i]
                    )
                )

                arena_gruesa_prof[i] = max(
                    arena_fina_prof[i],
                    min(
                        arena_gruesa_prof[i],
                        profundidad_grid[i]
                    )
                )

            contacto_cobertura = [
                terreno[i] - cobertura_prof[i]
                for i in range(len(grid_x))
            ]

            contacto_arena_fina = [
                terreno[i] - arena_fina_prof[i]
                for i in range(len(grid_x))
            ]

            contacto_lutita = [
                terreno[i] - arena_gruesa_prof[i]
                for i in range(len(grid_x))
            ]

            limite_observado = [
                terreno[i] - profundidad_grid[i]
                for i in range(len(grid_x))
            ]

            base = [
                base_horizontal
                for _ in grid_x
            ]

            for i in range(len(grid_x)):
                contacto_cobertura[i] = max(
                    contacto_cobertura[i],
                    limite_observado[i]
                )

                contacto_arena_fina[i] = min(
                    contacto_cobertura[i],
                    max(
                        contacto_arena_fina[i],
                        limite_observado[i]
                    )
                )

                contacto_lutita[i] = min(
                    contacto_arena_fina[i],
                    max(
                        contacto_lutita[i],
                        limite_observado[i]
                    )
                )

            # FACIES EXACTAS E INTERPOLACION POR POSICION
            # Cada sondeo conserva todos los intervalos reales del Excel.
            # Los limites de intervalo se interpolan entre sondeos y la
            # litologia lateral se asigna por proximidad al sondeo observado.
            max_intervalos = max(
                [
                    len(c["intervalos_exactos"])
                    for c in controles
                ]
            )

            if max_intervalos < 1:
                raise RuntimeError(
                    "Los sondeos seleccionados no contienen intervalos "
                    "litologicos validos."
                )

            # Profundidades de contacto por cada nivel estratigrafico.
            # INTERPRETACION GEOLOGICA SGM
            # Se construye una sucesion estratigrafica comun usando:
            # - orden medio de profundidad de cada litologia;
            # - espesor observado en cada sondeo;
            # - espesor cero cuando una unidad no aparece;
            # - interpolacion smoothstep para formar lentes y acunamientos.

            resumen_unidades = {}

            for control in controles:
                for intervalo in control["intervalos_exactos"]:
                    estilo = intervalo["estilo"]
                    espesor = max(
                        0.0,
                        intervalo["hasta"] - intervalo["desde"]
                    )
                    centro = (
                        intervalo["desde"] +
                        intervalo["hasta"]
                    ) / 2.0

                    if estilo not in resumen_unidades:
                        resumen_unidades[estilo] = {
                            "centros": [],
                            "nombres": [],
                            "presencias": 0
                        }

                    resumen_unidades[estilo]["centros"].append(
                        centro
                    )
                    resumen_unidades[estilo]["nombres"].append(
                        intervalo["litologia"]
                    )
                    resumen_unidades[estilo]["presencias"] += 1

            def mediana(valores):
                ordenados = sorted(valores)
                cantidad = len(ordenados)

                if cantidad == 0:
                    return 0.0

                mitad = cantidad // 2

                if cantidad % 2 == 1:
                    return ordenados[mitad]

                return (
                    ordenados[mitad - 1] +
                    ordenados[mitad]
                ) / 2.0

            unidades_geologicas = sorted(
                resumen_unidades.keys(),
                key=lambda estilo: mediana(
                    resumen_unidades[estilo]["centros"]
                )
            )

            # Evitar duplicar lutita generica y lutita gris.
            unidades_filtradas = []

            for estilo in unidades_geologicas:
                estilo_final = estilo

                if estilo_final == "lutita":
                    estilo_final = "lutita gris"

                if estilo_final not in unidades_filtradas:
                    unidades_filtradas.append(
                        estilo_final
                    )

            unidades_geologicas = unidades_filtradas

            # La lutita gris, cuando existe, se coloca como unidad basal.
            # Esto no obliga a que aparezca en todos los sondeos.
            if "lutita gris" in unidades_geologicas:
                unidades_geologicas = [
                    unidad for unidad in unidades_geologicas
                    if unidad != "lutita gris"
                ] + ["lutita gris"]

            max_intervalos = len(unidades_geologicas)

            if max_intervalos < 1:
                raise RuntimeError(
                    "No fue posible construir la sucesion geologica."
                )

            # Nombre representativo para cada unidad.
            nombres_unidades = {}

            for estilo in unidades_geologicas:
                nombres = []

                for control in controles:
                    for intervalo in control["intervalos_exactos"]:
                        estilo_intervalo = intervalo["estilo"]

                        if estilo_intervalo == "lutita":
                            estilo_intervalo = "lutita gris"

                        if estilo_intervalo == estilo:
                            nombres.append(
                                intervalo["litologia"]
                            )

                if estilo == "lutita gris":
                    nombres_unidades[estilo] = "Lutita gris"
                elif nombres:
                    nombres_unidades[estilo] = nombres[0]
                else:
                    nombres_unidades[estilo] = ESTILOS_LITOLOGIA[
                        estilo
                    ]["etiqueta"]

            # Informacion regional bajo cada sondeo.
            # Tiene menor jerarquia que la litologia perforada.
            unidades_regionales_control = []

            for control in controles:
                geometria_control = control["geom"]

                try:
                    punto_centro = geometria_control.centroid
                except Exception:
                    punto_centro = geometria_control.firstPoint

                punto_control = arcpy.PointGeometry(
                    arcpy.Point(
                        punto_centro.X,
                        punto_centro.Y
                    ),
                    geometria_control.spatialReference
                )

                datos_regionales = leer_unidad_regional_en_punto(
                    geologia_regional,
                    punto_control
                )

                unidades_regionales_control.append({
                    "datos": datos_regionales,
                    "estilo": clasificar_unidad_regional(
                        datos_regionales
                    )
                })

            # Espesor por unidad en cada sondeo.
            espesores_control = {}

            for estilo in unidades_geologicas:
                espesores_control[estilo] = []

                for control in controles:
                    espesor_total = 0.0

                    for intervalo in control["intervalos_exactos"]:
                        estilo_intervalo = intervalo["estilo"]

                        if estilo_intervalo == "lutita":
                            estilo_intervalo = "lutita gris"

                        if estilo_intervalo == estilo:
                            espesor_total += max(
                                0.0,
                                intervalo["hasta"] -
                                intervalo["desde"]
                            )

                    espesores_control[estilo].append(
                        espesor_total
                    )

            # Completar continuidad geologica antes de interpolar.
            # Una unidad presente a ambos lados de un sondeo intermedio
            # no se elimina de forma abrupta. Su espesor se infiere usando
            # los controles laterales. La lutita gris se considera la
            # unidad de fondo continua cuando existe evidencia suficiente.
            def completar_continuidad(
                valores,
                estilo
            ):
                resultado = list(valores)
                positivos = [
                    valor for valor in valores
                    if valor > 0.05
                ]

                if not positivos:
                    return resultado

                positivos_ordenados = sorted(positivos)
                espesor_mediano = positivos_ordenados[
                    len(positivos_ordenados) // 2
                ]

                for i in range(len(resultado)):
                    if resultado[i] > 0.05:
                        continue

                    izquierda = None
                    derecha = None

                    for j in range(i - 1, -1, -1):
                        if valores[j] > 0.05:
                            izquierda = j
                            break

                    for j in range(i + 1, len(valores)):
                        if valores[j] > 0.05:
                            derecha = j
                            break

                    if (
                        izquierda is not None and
                        derecha is not None
                    ):
                        distancia_total = (
                            control_x[derecha] -
                            control_x[izquierda]
                        )

                        if distancia_total > 0:
                            fraccion = (
                                control_x[i] -
                                control_x[izquierda]
                            ) / float(distancia_total)

                            valor_inferido = (
                                valores[izquierda] +
                                (
                                    valores[derecha] -
                                    valores[izquierda]
                                ) * fraccion
                            )

                            resultado[i] = (
                                valor_inferido *
                                factor_persistencia
                            )
                        else:
                            resultado[i] = (
                                (
                                    valores[izquierda] +
                                    valores[derecha]
                                ) / 2.0
                            ) * factor_persistencia

                return resultado

            # Conservar una copia estricta de lo observado.
            # "Esperada" usa directamente esos valores, incluidos los ceros.
            # "Comun" puede inferir continuidad entre controles.
            espesores_control_observados = {
                estilo: list(espesores_control[estilo])
                for estilo in unidades_geologicas
            }

            if usar_litologia_comun:
                for estilo in unidades_geologicas:
                    espesores_control[estilo] = completar_continuidad(
                        espesores_control_observados[estilo],
                        estilo
                    )
            else:
                for estilo in unidades_geologicas:
                    espesores_control[estilo] = list(
                        espesores_control_observados[estilo]
                    )

            # Criterio litologico:
            # Esperada conserva presencia/ausencia observada.
            # Comun favorece la unidad dominante y permite continuidad
            # inferida donde existe soporte a ambos lados.
            totales_litologicos = {}

            for estilo_local in unidades_geologicas:
                totales_litologicos[estilo_local] = sum(
                    max(0.0, valor)
                    for valor in espesores_control_observados[estilo_local]
                )

            estilo_litologia_comun = (
                max(
                    totales_litologicos.keys(),
                    key=lambda clave: totales_litologicos[clave]
                )
                if totales_litologicos
                else None
            )

            msg_local(
                "Criterio litologico activo: {0}; continuidad: {1}; "
                "exponente: {2:.2f}."
                .format(
                    "Comun" if usar_litologia_comun else "Esperada",
                    nivel_continuidad,
                    potencia_interpolado
                )
            )

            if usar_litologia_comun:
                msg_local(
                    "Modo Comun: se permite inferir continuidad entre "
                    "controles y reforzar la litologia dominante."
                )
            else:
                msg_local(
                    "Modo Esperada: las ausencias observadas permanecen "
                    "como cero en los controles."
                )

            msg_local(
                "Etapa 3/6: interpolando unidades geologicas..."
            )

            # Interpolar espesores con continuidad lateral.
            espesores_grid = {}

            for estilo in unidades_geologicas:
                if not interpolar_geologia:
                    espesores_grid[estilo] = [
                        0.0 for _ in grid_x
                    ]
                    continue

                valores_control = list(
                    espesores_control_observados[estilo]
                )
                valores_interpolacion = list(
                    espesores_control[estilo]
                    if usar_litologia_comun
                    else valores_control
                )

                if (
                    usar_litologia_comun and
                    estilo == estilo_litologia_comun
                ):
                    positivos_comunes = sorted([
                        valor for valor in valores_control
                        if valor > 0.05
                    ])

                    if positivos_comunes:
                        espesor_comun = positivos_comunes[
                            len(positivos_comunes) // 2
                        ]

                        valores_interpolacion = [
                            (
                                valor
                                if valor > 0.05
                                else espesor_comun * factor_comun
                            )
                            for valor in valores_control
                        ]

                valores_grid = [
                    max(
                        0.0,
                        interpolar_geologico(
                            control_x,
                            valores_interpolacion,
                            x
                        )
                    )
                    for x in grid_x
                ]

                # Suavizado moderado, preservando lentes y acunamientos.
                valores_grid = suavizar_contacto(
                    valores_grid,
                    iteraciones_continuidad
                )

                # Eliminar residuos muy delgados producidos por el suavizado.
                valores_grid = [
                    0.0 if valor < 0.03 else valor
                    for valor in valores_grid
                ]

                # Alcance lateral real de la litologia.
                # La continuidad controla hasta donde puede propagarse
                # una unidad desde los controles donde fue observada.
                controles_positivos_litologia = [
                    indice_control
                    for indice_control, valor_control
                    in enumerate(valores_control)
                    if valor_control > 0.05
                ]

                if controles_positivos_litologia:
                    pesos_correlacion = [
                        0.0 for _ in grid_x
                    ]

                    for indice_positivo in controles_positivos_litologia:
                        x_positivo = control_x[indice_positivo]
                        distancias_referencia = []

                        if indice_positivo > 0:
                            distancias_referencia.append(
                                abs(
                                    x_positivo -
                                    control_x[indice_positivo - 1]
                                )
                            )

                        if indice_positivo < len(control_x) - 1:
                            distancias_referencia.append(
                                abs(
                                    control_x[indice_positivo + 1] -
                                    x_positivo
                                )
                            )

                        if distancias_referencia:
                            espaciamiento_local = max(
                                min(distancias_referencia),
                                1.0
                            )
                        elif len(control_x) > 1:
                            espaciamiento_local = max(
                                abs(control_x[-1] - control_x[0]),
                                1.0
                            )
                        else:
                            espaciamiento_local = max(
                                (grid_x[-1] - grid_x[0]) * 0.25,
                                1.0
                            )

                        radio_correlacion = (
                            espaciamiento_local *
                            factor_radio_correlacion
                        )

                        if (
                            usar_litologia_comun and
                            estilo == estilo_litologia_comun
                        ):
                            radio_correlacion *= (
                                multiplicador_radio_comun
                            )

                        radio_correlacion = max(
                            radio_correlacion,
                            (
                                grid_x[1] - grid_x[0]
                                if len(grid_x) > 1 else 1.0
                            ) * 2.0
                        )

                        for indice_grid_local, x_grid_local in enumerate(
                            grid_x
                        ):
                            distancia_local = abs(
                                x_grid_local - x_positivo
                            )

                            if distancia_local >= radio_correlacion:
                                continue

                            fraccion_radio = (
                                1.0 -
                                distancia_local /
                                float(radio_correlacion)
                            )

                            # Smootherstep de influencia: 1 en el control
                            # y 0 en el limite del radio de correlacion.
                            peso_radio = (
                                fraccion_radio *
                                fraccion_radio *
                                fraccion_radio *
                                (
                                    fraccion_radio *
                                    (
                                        fraccion_radio * 6.0 -
                                        15.0
                                    ) +
                                    10.0
                                )
                            )

                            if peso_radio > pesos_correlacion[
                                indice_grid_local
                            ]:
                                pesos_correlacion[
                                    indice_grid_local
                                ] = peso_radio

                    # En criterio Comun, la unidad dominante puede
                    # atravesar parcialmente zonas sin observacion directa,
                    # siempre dentro del tramo respaldado por controles.
                    if (
                        usar_litologia_comun and
                        estilo == estilo_litologia_comun and
                        len(controles_positivos_litologia) >= 2
                    ):
                        x_primero_comun = control_x[
                            controles_positivos_litologia[0]
                        ]
                        x_ultimo_comun = control_x[
                            controles_positivos_litologia[-1]
                        ]

                        piso_comun = min(
                            0.85,
                            max(
                                0.10,
                                factor_comun
                            )
                        )

                        for indice_grid_local, x_grid_local in enumerate(
                            grid_x
                        ):
                            if (
                                x_primero_comun <= x_grid_local <=
                                x_ultimo_comun
                            ):
                                pesos_correlacion[indice_grid_local] = max(
                                    pesos_correlacion[indice_grid_local],
                                    piso_comun
                                )

                    valores_grid = [
                        max(
                            0.0,
                            valores_grid[indice_grid_local] *
                            pesos_correlacion[indice_grid_local]
                        )
                        for indice_grid_local in range(len(grid_x))
                    ]
                else:
                    valores_grid = [
                        0.0 for _ in grid_x
                    ]

                # Eliminar nuevamente residuos despues de aplicar
                # el alcance lateral.
                valores_grid = [
                    0.0 if valor < 0.03 else valor
                    for valor in valores_grid
                ]

                # Los sondeos son controles estrictos. El espesor calculado
                # debe coincidir exactamente con el observado en cada barreno.
                # La correccion se desvanece gradualmente entre sondeos para
                # conservar una geometria suave sin alterar el dato real.
                for indice_control, x_control in enumerate(control_x):
                    indice_grid = min(
                        range(len(grid_x)),
                        key=lambda indice: abs(
                            grid_x[indice] - x_control
                        )
                    )

                    valor_objetivo = valores_control[
                        indice_control
                    ]
                    diferencia = (
                        valor_objetivo -
                        valores_grid[indice_grid]
                    )

                    if len(control_x) > 1:
                        distancias_vecinas = []

                        if indice_control > 0:
                            distancias_vecinas.append(
                                abs(
                                    x_control -
                                    control_x[indice_control - 1]
                                )
                            )

                        if indice_control < len(control_x) - 1:
                            distancias_vecinas.append(
                                abs(
                                    control_x[indice_control + 1] -
                                    x_control
                                )
                            )

                        if estilo.startswith("arena"):
                            fraccion_anclaje_base = 0.34
                        elif estilo == "arcilla":
                            fraccion_anclaje_base = 0.30
                        elif estilo in (
                            "gravas",
                            "conglomerado"
                        ):
                            fraccion_anclaje_base = 0.31
                        else:
                            fraccion_anclaje_base = 0.20

                        fraccion_anclaje = (
                            fraccion_anclaje_base *
                            factor_anclaje
                        )

                        radio_anclaje = max(
                            min(distancias_vecinas) * fraccion_anclaje,
                            1.0
                        )
                    else:
                        radio_anclaje = max(
                            (grid_x[-1] - grid_x[0]) * 0.10,
                            1.0
                        )

                    for indice in range(len(grid_x)):
                        distancia = abs(
                            grid_x[indice] - x_control
                        )

                        if distancia <= radio_anclaje:
                            peso = (
                                1.0 -
                                distancia / float(radio_anclaje)
                            )
                            peso = peso * peso * (
                                3.0 - 2.0 * peso
                            )

                            valores_grid[indice] = max(
                                0.0,
                                valores_grid[indice] +
                                diferencia * peso
                            )

                    # Garantizar coincidencia exacta en el punto del sondeo.
                    valores_grid[indice_grid] = max(
                        0.0,
                        valor_objetivo
                    )

                espesores_grid[estilo] = valores_grid

            # La geologia regional se usa unicamente para completar
            # la unidad inferior fuera del alcance perforado.
            # No modifica los intervalos registrados en los sondeos.
            # Unidad regional inferior por tramos
            # La capa geologica regional se muestrea a lo largo de toda
            # la linea de seccion. Cada posicion del perfil recibe la
            # unidad regional que realmente intersecta en planta.
            estilos_regionales_grid = []
            datos_regionales_grid = []

            if geologia_regional:
                for distancia_grid in grid_x:
                    try:
                        punto_linea = linea.positionAlongLine(
                            distancia_grid,
                            False
                        )
                    except Exception:
                        punto_linea = linea.positionAlongLine(
                            distancia_grid
                        )

                    datos_regionales = leer_unidad_regional_en_punto(
                        geologia_regional,
                        punto_linea
                    )

                    estilo_regional = clasificar_unidad_regional(
                        datos_regionales
                    )

                    estilos_regionales_grid.append(
                        estilo_regional
                    )
                    datos_regionales_grid.append(
                        datos_regionales
                    )
            else:
                estilos_regionales_grid = [
                    None for _ in grid_x
                ]
                datos_regionales_grid = [
                    None for _ in grid_x
                ]

            agua_regional_grid = [
                es_agua_regional(datos)
                for datos in datos_regionales_grid
            ]

            # Capa de cuerpos de agua seleccionada por el usuario.
            capa_agua_proyecto = CONFIG_PROYECTO.get("agua")

            if capa_agua_proyecto:
                msg_local(
                    "Analizando intersecciones con cuerpos de agua..."
                )
                mascara_agua_proyecto = _mascara_agua_linea(
                    capa_agua_proyecto,
                    linea,
                    grid_x,
                    msg_local
                )

                agua_regional_grid = [
                    bool(
                        agua_regional_grid[indice] or
                        mascara_agua_proyecto[indice]
                    )
                    for indice in range(len(grid_x))
                ]

                cantidad_agua = sum(
                    1 for valor_agua in mascara_agua_proyecto
                    if valor_agua
                )
                if cantidad_agua > 0:
                    msg_local(
                        "Cuerpos de agua incorporados: {0} muestras."
                        .format(cantidad_agua)
                    )
                else:
                    warn_local(
                        "La capa de agua no intersecta esta linea "
                        "dentro de la tolerancia de 15 m."
                    )

            # Incorporar todas las unidades regionales realmente presentes
            # en la linea, sin sustituir las unidades observadas en barreno.
            estilos_regionales_presentes = []

            for estilo_regional in estilos_regionales_grid:
                if (
                    estilo_regional and
                    estilo_regional not in estilos_regionales_presentes
                ):
                    estilos_regionales_presentes.append(
                        estilo_regional
                    )

            for estilo_regional in estilos_regionales_presentes:
                etiqueta_regional = (
                    ESTILOS_LITOLOGIA[
                        estilo_regional
                    ]["etiqueta"] +
                    " regional"
                )

                if estilo_regional not in unidades_geologicas:
                    unidades_geologicas.append(
                        estilo_regional
                    )
                    espesores_control[estilo_regional] = [
                        0.0 for _ in controles
                    ]
                    espesores_grid[estilo_regional] = [
                        0.0 for _ in grid_x
                    ]

                nombres_unidades[
                    estilo_regional
                ] = etiqueta_regional

            max_intervalos = len(
                unidades_geologicas
            )

            # Unidad basal de respaldo. No modifica el interpolado:
            # unicamente completa el remanente vertical que antes quedaba
            # blanco o producia adelgazamientos visuales.
            if "lutita gris" in unidades_geologicas:
                estilo_basal_respaldo = "lutita gris"
            elif "lutita" in unidades_geologicas:
                estilo_basal_respaldo = "lutita"
            elif unidades_geologicas:
                estilo_basal_respaldo = unidades_geologicas[-1]
            else:
                estilo_basal_respaldo = None

            # Ajustar la suma de espesores a la profundidad investigada.
            for i in range(len(grid_x)):
                suma_espesores = sum(
                    espesores_grid[estilo][i]
                    for estilo in unidades_geologicas
                )

                profundidad_disponible = max(
                    profundidad_grid[i],
                    profundidad_interpretacion
                )

                if (
                    suma_espesores > profundidad_disponible and
                    suma_espesores > 0
                ):
                    factor = (
                        profundidad_disponible /
                        float(suma_espesores)
                    )

                    for estilo in unidades_geologicas:
                        espesores_grid[estilo][i] *= factor

                # Completar siempre el intervalo hasta la linea de
                # profundidad. La geologia regional tiene prioridad;
                # donde no existe se usa la unidad basal de respaldo.
                estilo_relleno_local = estilo_basal_respaldo

                suma_ajustada = sum(
                    espesores_grid[estilo][i]
                    for estilo in unidades_geologicas
                )

                remanente = max(
                    0.0,
                    profundidad_disponible -
                    suma_ajustada
                )

                if (
                    interpolar_geologia and
                    estilo_relleno_local and
                    remanente > 0.0
                ):
                    espesores_grid[
                        estilo_relleno_local
                    ][i] += remanente

            # La litologia observada se respeta dentro del barreno.
            # Fuera del intervalo perforado no se impone una columna
            # absoluta. Por debajo de 30 m domina progresivamente la
            # interpolacion circundante y la unidad basal regional del
            # propio conjunto de sondeos.

            # Completar el espesor residual hasta la profundidad
            # solicitada. La unidad basal circundante recibe solamente
            # el tramo que falta, sin modificar los intervalos perforados.
            if (
                interpolar_geologia and
                estilo_basal_respaldo in espesores_grid
            ):
                for indice_grid in range(len(grid_x)):
                    espesor_total = sum(
                        espesores_grid[estilo][indice_grid]
                        for estilo in unidades_geologicas
                    )
                    espesor_faltante = max(
                        0.0,
                        float(profundidad_interpretacion) -
                        espesor_total
                    )

                    if espesor_faltante > 0.0:
                        espesores_grid[
                            estilo_basal_respaldo
                        ][indice_grid] += espesor_faltante

            # Contactos acumulados desde la superficie.
            contactos_profundidad = [
                [0.0 for _ in grid_x]
            ]

            acumulado = [
                0.0 for _ in grid_x
            ]

            for estilo in unidades_geologicas:
                acumulado = [
                    min(
                        profundidad_grid[i],
                        acumulado[i] +
                        espesores_grid[estilo][i]
                    )
                    for i in range(len(grid_x))
                ]

                iteraciones_contacto = max(
                    1,
                    int(
                        round(
                            iteraciones_continuidad * 0.50
                        )
                    )
                )

                contacto_suavizado = suavizar_contacto(
                    list(acumulado),
                    iteraciones_contacto
                )

                # CONTROL ESTRICTO EN LOS BARRENOS
                # La interpolacion se suaviza entre sondeos, pero en la
                # posicion de cada perforacion conserva exactamente la
                # profundidad acumulada de los intervalos registrados.
                indice_unidad_actual = unidades_geologicas.index(
                    estilo
                )

                for indice_control, control in enumerate(controles):
                    profundidad_objetivo = 0.0

                    for unidad_previa in unidades_geologicas[
                        :indice_unidad_actual + 1
                    ]:
                        for intervalo in control["intervalos_exactos"]:
                            clave_intervalo = intervalo["estilo"]

                            if clave_intervalo == "lutita":
                                clave_intervalo = "lutita gris"

                            if clave_intervalo == unidad_previa:
                                profundidad_objetivo += max(
                                    0.0,
                                    intervalo["hasta"] -
                                    intervalo["desde"]
                                )

                    profundidad_objetivo = min(
                        control["profundidad"],
                        profundidad_objetivo
                    )

                    indice_grid = min(
                        range(len(grid_x)),
                        key=lambda indice: abs(
                            grid_x[indice] - control["x"]
                        )
                    )

                    diferencia = (
                        profundidad_objetivo -
                        contacto_suavizado[indice_grid]
                    )

                    # Zona corta de fidelidad alrededor del barreno.
                    distancias_vecinas = []

                    if indice_control > 0:
                        distancias_vecinas.append(
                            abs(
                                control["x"] -
                                controles[indice_control - 1]["x"]
                            )
                        )

                    if indice_control < len(controles) - 1:
                        distancias_vecinas.append(
                            abs(
                                controles[indice_control + 1]["x"] -
                                control["x"]
                            )
                        )

                    paso_grid_local = (
                        grid_x[1] - grid_x[0]
                        if len(grid_x) > 1 else 1.0
                    )

                    if distancias_vecinas:
                        factor_fidelidad = {
                            "Baja": 0.045,
                            "Media": 0.065,
                            "Alta": 0.090,
                            "Muy alta": 0.120
                        }.get(
                            nivel_continuidad,
                            0.065
                        )

                        radio_fidelidad = max(
                            paso_grid_local * 2.0,
                            min(distancias_vecinas) * factor_fidelidad
                        )
                    else:
                        radio_fidelidad = paso_grid_local * 2.0

                    for indice_local in range(len(grid_x)):
                        distancia_local = abs(
                            grid_x[indice_local] - control["x"]
                        )

                        if distancia_local <= radio_fidelidad:
                            peso = (
                                1.0 -
                                distancia_local /
                                float(radio_fidelidad)
                            )
                            peso = peso * peso * (
                                3.0 - 2.0 * peso
                            )

                            contacto_suavizado[indice_local] += (
                                diferencia * peso
                            )

                    contacto_suavizado[indice_grid] = (
                        profundidad_objetivo
                    )

                # Mantener el contacto dentro de la profundidad investigada
                # y por debajo del contacto anterior.
                contacto_anterior = contactos_profundidad[-1]

                contacto_suavizado = [
                    max(
                        contacto_anterior[i],
                        min(
                            profundidad_grid[i],
                            contacto_suavizado[i]
                        )
                    )
                    for i in range(len(grid_x))
                ]

                # Reafirmar el valor exacto despues de aplicar limites.
                for control in controles:
                    indice_grid = min(
                        range(len(grid_x)),
                        key=lambda indice: abs(
                            grid_x[indice] - control["x"]
                        )
                    )

                    profundidad_objetivo = 0.0

                    for unidad_previa in unidades_geologicas[
                        :indice_unidad_actual + 1
                    ]:
                        for intervalo in control["intervalos_exactos"]:
                            clave_intervalo = intervalo["estilo"]

                            if clave_intervalo == "lutita":
                                clave_intervalo = "lutita gris"

                            if clave_intervalo == unidad_previa:
                                profundidad_objetivo += max(
                                    0.0,
                                    intervalo["hasta"] -
                                    intervalo["desde"]
                                )

                    contacto_suavizado[indice_grid] = max(
                        contacto_anterior[indice_grid],
                        min(
                            control["profundidad"],
                            profundidad_objetivo
                        )
                    )

                contactos_profundidad.append(
                    contacto_suavizado
                )

                acumulado = list(contacto_suavizado)

            # La ultima superficie llega exactamente a la
            # profundidad solicitada, incluso si supera 30 m.
            if (
                interpolar_geologia and
                contactos_profundidad
            ):
                contactos_profundidad[-1] = list(
                    profundidad_grid
                )

            # Facies por nivel: cada unidad conserva su identidad,
            # pero desaparece donde su espesor llega a cero.
            facies_por_nivel = []

            for estilo in unidades_geologicas:
                facies_nivel = []

                for i in range(len(grid_x)):
                    facies_nivel.append({
                        "estilo": estilo,
                        "litologia": nombres_unidades[estilo],
                        "espesor": espesores_grid[estilo][i]
                    })

                facies_por_nivel.append(
                    facies_nivel
                )

            # Superficies de elevacion real para cada contacto.
            superficies_facies = []

            for nivel in range(max_intervalos + 1):
                superficies_facies.append([
                    terreno[i] -
                    contactos_profundidad[nivel][i]
                    for i in range(len(grid_x))
                ])

            if "material organico" not in ESTILOS_LITOLOGIA:
                raise RuntimeError(
                    "La simbologia organica no esta definida."
                )

            msg_local(
                "Simbologia organica activa: Material organico."
            )
            msg_local(
                "Productos: seccion PNG, control litologico y reporte "
                "litologico y CSV por sondeo."
            )

            terreno_y = [
                (z - base_horizontal) * ev
                for z in terreno
            ]

            cobertura_y = [
                (z - base_horizontal) * ev
                for z in contacto_cobertura
            ]

            arena_fina_y = [
                (z - base_horizontal) * ev
                for z in contacto_arena_fina
            ]

            lutita_y = [
                (z - base_horizontal) * ev
                for z in contacto_lutita
            ]

            observado_y = [
                (z - base_horizontal) * ev
                for z in limite_observado
            ]

            base_y = [
                0.0
                for _ in grid_x
            ]

            longitud = x_fin - x_inicio
            margen_x = max(
                200.0,
                longitud * margen_horizontal_pct
            )

            # Espacio suficiente para las etiquetas elevadas 5 m.
            elevacion_superior = max(
                max(terreno) + 12.0,
                max(
                    [
                        terreno_en_x(c["x"]) + 10.0
                        for c in controles
                    ]
                )
            )

            if (
                modo_vertical_motor in (
                    "misma para todas",
                    "personalizada"
                ) and
                elevacion_superior_comun is not None and
                elevacion_inferior_comun is not None
            ):
                elevacion_superior = float(
                    elevacion_superior_comun
                )

            longitud_referencia = float(
                CONFIG_PROYECTO.get(
                    "longitud_marco",
                    0.0
                ) or 0.0
            )
            rango_vertical_referencia = float(
                CONFIG_PROYECTO.get(
                    "rango_vertical_referencia",
                    0.0
                ) or 0.0
            )
            escala_horizontal_objetivo = float(
                CONFIG_PROYECTO.get(
                    "escala_horizontal_objetivo",
                    0.0
                ) or 0.0
            )
            escala_vertical_objetivo = float(
                CONFIG_PROYECTO.get(
                    "escala_vertical_objetivo",
                    0.0
                ) or 0.0
            )

            longitud_local_figura = max(
                longitud_real,
                1.0
            )
            rango_vertical_local = max(
                elevacion_superior - base_horizontal,
                1.0
            )

            modo_horizontal_figura = normalizar_texto(
                CONFIG_PROYECTO.get(
                    "modo_escala",
                    "automatica"
                )
            )
            modo_vertical_figura = normalizar_texto(
                CONFIG_PROYECTO.get(
                    "modo_vertical",
                    "automatica"
                )
            )

            if longitud_referencia <= 0.0:
                longitud_referencia = longitud_local_figura

            if rango_vertical_referencia <= 0.0:
                rango_vertical_referencia = rango_vertical_local

            ancho_panel_referencia = (
                ANCHO_FIGURA_IN *
                POSICION_PERFIL[2]
            )
            alto_panel_referencia = (
                ALTO_FIGURA_IN *
                POSICION_PERFIL[3]
            )

            ancho_panel = ancho_panel_referencia

            if modo_vertical_figura in (
                "misma para todas",
                "personalizada"
            ):
                alto_panel = alto_panel_referencia
            else:
                alto_panel = (
                    alto_panel_referencia *
                    rango_vertical_local /
                    rango_vertical_referencia
                )
            longitud_para_escala = longitud_referencia
            rango_para_escala = (
                rango_vertical_referencia
                if modo_vertical_figura in (
                    "misma para todas",
                    "personalizada"
                )
                else rango_vertical_local
            )

            escala_horizontal_real = int(
                round(
                    (
                        longitud_para_escala * 1000.0
                    ) /
                    max(
                        ancho_panel * 25.4,
                        0.001
                    )
                )
            )
            escala_vertical_real = int(
                round(
                    (
                        rango_para_escala * 1000.0
                    ) /
                    max(
                        alto_panel * 25.4,
                        0.001
                    )
                )
            )

            escala_objetivo_activa = (
                escala_horizontal_objetivo > 0.0 or
                escala_vertical_objetivo > 0.0
            )

            if escala_horizontal_objetivo > 0.0:
                # La EH capturada tiene prioridad absoluta.
                # No se suma la medida inicial de la geometria.
                escala_horizontal_real = int(
                    round(
                        float(
                            escala_horizontal_objetivo
                        )
                    )
                )

            if escala_vertical_objetivo > 0.0:
                escala_vertical_real = int(
                    round(escala_vertical_objetivo)
                )

            aspecto_escala_objetivo = None

            if escala_objetivo_activa:
                aspecto_escala_objetivo = (
                    float(escala_horizontal_real) /
                    max(float(escala_vertical_real), 0.001)
                )

            ancho_figura = ANCHO_FIGURA_IN
            alto_figura = ALTO_FIGURA_IN

            proporcion_horizontal_panel = 1.0
            derecha_perfil = 0.725

            msg_local(
                "Longitud interpretada: {0:.1f} m; "
                "marco horizontal proporcional: {1:.1f}%."
                .format(
                    longitud_local_figura,
                    proporcion_horizontal_panel * 100.0
                )
            )

            msg_local(
                "Escala comparable: ancho {0:.2f} in, alto {1:.2f} in."
                .format(
                    ancho_figura,
                    alto_figura
                )
            )

            msg_local(
                "Etapa 4/6: preparando figura..."
            )

            # Cada seccion inicia con un lienzo limpio e identico.
            try:
                plt.close("all")
            except Exception:
                pass

            fig = plt.figure(
                figsize=(ancho_figura, alto_figura),
                dpi=DPI_SALIDA
            )
            fig.set_size_inches(
                ancho_figura,
                alto_figura,
                forward=True
            )

            ax = fig.add_subplot(111)

            if aspecto_escala_objetivo is not None:
                msg_local(
                    "Escalas seleccionadas aplicadas sin recalculo: "
                    "EH 1:{0:,} | EV 1:{1:,}."
                    .format(
                        escala_horizontal_real,
                        escala_vertical_real
                    )
                )
                msg_local(
                    "Escalas de referencia: EH 1:{0:,} | "
                    "EV 1:{1:,}. El marco conserva dimensiones "
                    "homologadas."
                    .format(
                        escala_horizontal_real,
                        escala_vertical_real
                    )
                )

            # Configuracion grafica de salida.
            try:
                fig.patch.set_facecolor("white")
            except Exception:
                pass

            # Ajuste compatible con la version de Matplotlib incluida en ArcMap 10.8.
            try:
                ax.set_facecolor("white")
            except AttributeError:
                try:
                    ax.set_axis_bgcolor("white")
                except Exception:
                    pass

            ax.spines["top"].set_visible(False)
            ax.spines["right"].set_visible(False)
            ax.spines["left"].set_linewidth(0.8)
            ax.spines["bottom"].set_linewidth(0.8)

            # Configuracion de ejes visibles.
            ax.tick_params(
                axis="x",
                which="both",
                top=False,
                bottom=True,
                labeltop=False,
                direction="out",
                length=4,
                width=0.7
            )
            ax.tick_params(
                axis="y",
                which="both",
                right=False,
                left=True,
                labelright=False,
                direction="out",
                length=4,
                width=0.7
            )

            try:
                plt.rcParams["font.family"] = "Arial"
            except Exception:
                pass

            # Representacion de facies entre contactos interpolados.
            estilos_usados = {}

            superficies_facies_y = [
                [
                    (z - base_horizontal) * ev
                    for z in superficie
                ]
                for superficie in superficies_facies
            ]

            niveles_interpretados = (
                range(max_intervalos)
                if interpolar_geologia
                else []
            )

            msg_local(
                "Modelo 2D listo para dibujo: {0} controles; "
                "{1} unidades geologicas; interpolacion={2}."
                .format(
                    len(controles),
                    max_intervalos,
                    "Si" if interpolar_geologia else "No"
                )
            )

            for nivel in niveles_interpretados:
                inicio_tramo = 0

                while inicio_tramo < len(grid_x):
                    estilo_actual = facies_por_nivel[
                        nivel
                    ][inicio_tramo]["estilo"]

                    fin_tramo = inicio_tramo

                    while (
                        fin_tramo + 1 < len(grid_x) and
                        facies_por_nivel[nivel][
                            fin_tramo + 1
                        ]["estilo"] == estilo_actual
                    ):
                        fin_tramo += 1

                    # Solapar una muestra en cada extremo para evitar
                    # costuras blancas entre poligonos contiguos.
                    inicio_dibujo = max(0, inicio_tramo - 1)
                    fin_dibujo = min(
                        len(grid_x) - 1,
                        fin_tramo + 1
                    )

                    x_segmento = grid_x[
                        inicio_dibujo:fin_dibujo + 1
                    ]
                    y_superior = superficies_facies_y[
                        nivel
                    ][inicio_dibujo:fin_dibujo + 1]
                    y_inferior = superficies_facies_y[
                        nivel + 1
                    ][inicio_dibujo:fin_dibujo + 1]

                    espesor_visible = max([
                        y_superior[j] - y_inferior[j]
                        for j in range(len(x_segmento))
                    ])

                    if (
                        len(x_segmento) >= 2 and
                        espesor_visible > 0.1
                    ):
                        estilo_info = ESTILOS_LITOLOGIA[
                            estilo_actual
                        ]

                        ax.fill_between(
                            x_segmento,
                            y_superior,
                            y_inferior,
                            facecolor=estilo_info["color"],
                            edgecolor="#111111",
                            linewidth=0.0,
                            hatch=(estilo_info["trama"] if activar_trama else None),
                            zorder=5
                        )

                        estilos_usados[estilo_actual] = estilo_info

                    inicio_tramo = fin_tramo + 1

            if not interpolar_geologia:
                # Proyeccion estricta: se dibujan solamente los intervalos
                # realmente observados en cada control, sin unir columnas.
                paso_visual = (
                    grid_x[1] - grid_x[0]
                    if len(grid_x) > 1 else
                    max(longitud_real * 0.002, 1.0)
                )

                for indice_control, control in enumerate(controles):
                    distancias_vecinas = []

                    if indice_control > 0:
                        distancias_vecinas.append(
                            abs(
                                control["x"] -
                                controles[indice_control - 1]["x"]
                            )
                        )

                    if indice_control < len(controles) - 1:
                        distancias_vecinas.append(
                            abs(
                                controles[indice_control + 1]["x"] -
                                control["x"]
                            )
                        )

                    ancho_columna = max(
                        paso_visual * 3.0,
                        longitud_real * 0.003
                    )

                    if distancias_vecinas:
                        ancho_columna = min(
                            ancho_columna,
                            min(distancias_vecinas) * 0.08
                        )

                    ancho_columna = max(
                        ancho_columna,
                        paso_visual * 2.0
                    )

                    mitad_columna = ancho_columna * 0.5
                    x_izquierda = max(
                        x_inicio,
                        control["x"] - mitad_columna
                    )
                    x_derecha = min(
                        x_fin,
                        control["x"] + mitad_columna
                    )

                    if x_derecha <= x_izquierda:
                        continue

                    elevacion_control = interpolar_lineal(
                        grid_x,
                        terreno,
                        control["x"]
                    )

                    for intervalo_control in control[
                        "intervalos_exactos"
                    ]:
                        desde_control = max(
                            0.0,
                            float(intervalo_control["desde"])
                        )
                        hasta_control = min(
                            float(control["profundidad"]),
                            float(intervalo_control["hasta"])
                        )

                        if hasta_control <= desde_control:
                            continue

                        estilo_control = intervalo_control.get(
                            "estilo",
                            "otro"
                        )

                        if estilo_control == "lutita":
                            estilo_control = "lutita gris"

                        if estilo_control not in ESTILOS_LITOLOGIA:
                            estilo_control = "otro"

                        estilo_info = ESTILOS_LITOLOGIA[
                            estilo_control
                        ]

                        y_superior_control = (
                            (
                                elevacion_control -
                                desde_control -
                                base_horizontal
                            ) * ev
                        )
                        y_inferior_control = (
                            (
                                elevacion_control -
                                hasta_control -
                                base_horizontal
                            ) * ev
                        )

                        ax.fill_between(
                            [x_izquierda, x_derecha],
                            [
                                y_superior_control,
                                y_superior_control
                            ],
                            [
                                y_inferior_control,
                                y_inferior_control
                            ],
                            facecolor=estilo_info["color"],
                            edgecolor="#111111",
                            linewidth=0.45,
                            hatch=(estilo_info["trama"] if activar_trama else None),
                            zorder=7
                        )

                        estilos_usados[
                            estilo_control
                        ] = estilo_info

                msg_local(
                    "Modo sin interpolacion: {0} controles proyectados "
                    "con sus intervalos perforados."
                    .format(len(controles))
                )

            # Debajo del fondo perforado se conserva el resultado
            # interpolado de las unidades vecinas. No se dibuja una
            # columna artificial con la ultima litologia del barreno.

            # Proteccion grafica: si el modelo calculo unidades pero el
            # primer renderizado no genero rellenos, se reconstruyen las
            # mismas superficies sin alterar la interpolacion.
            if (
                interpolar_geologia and
                max_intervalos > 0 and
                not estilos_usados
            ):
                warn_local(
                    "El primer renderizado 2D no genero rellenos. "
                    "Aplicando renderizado geologico de respaldo."
                )

                poligonos_respaldo = 0

                for nivel_respaldo in range(max_intervalos):
                    estilo_respaldo = unidades_geologicas[
                        nivel_respaldo
                    ]

                    if estilo_respaldo not in ESTILOS_LITOLOGIA:
                        continue

                    estilo_info_respaldo = ESTILOS_LITOLOGIA[
                        estilo_respaldo
                    ]
                    inicio_respaldo = None

                    for indice_respaldo in range(len(grid_x) + 1):
                        activo_respaldo = (
                            indice_respaldo < len(grid_x) and
                            facies_por_nivel[
                                nivel_respaldo
                            ][indice_respaldo].get(
                                "espesor",
                                0.0
                            ) > 0.03
                        )

                        if activo_respaldo and inicio_respaldo is None:
                            inicio_respaldo = indice_respaldo

                        if (
                            inicio_respaldo is not None and
                            (
                                not activo_respaldo or
                                indice_respaldo == len(grid_x)
                            )
                        ):
                            fin_respaldo = indice_respaldo - 1

                            if fin_respaldo - inicio_respaldo >= 1:
                                x_respaldo = grid_x[
                                    inicio_respaldo:
                                    fin_respaldo + 1
                                ]
                                y_sup_respaldo = superficies_facies_y[
                                    nivel_respaldo
                                ][
                                    inicio_respaldo:
                                    fin_respaldo + 1
                                ]
                                y_inf_respaldo = superficies_facies_y[
                                    nivel_respaldo + 1
                                ][
                                    inicio_respaldo:
                                    fin_respaldo + 1
                                ]

                                if (
                                    x_respaldo and
                                    max(
                                        [
                                            y_sup_respaldo[i_local] -
                                            y_inf_respaldo[i_local]
                                            for i_local in range(
                                                len(x_respaldo)
                                            )
                                        ]
                                    ) > 0.1
                                ):
                                    ax.fill_between(
                                        x_respaldo,
                                        y_sup_respaldo,
                                        y_inf_respaldo,
                                        facecolor=estilo_info_respaldo[
                                            "color"
                                        ],
                                        edgecolor="#111111",
                                        linewidth=0.0,
                                        hatch=None,
                                        zorder=5
                                    )
                                    estilos_usados[
                                        estilo_respaldo
                                    ] = estilo_info_respaldo
                                    poligonos_respaldo += 1

                            inicio_respaldo = None

                msg_local(
                    "Renderizado geologico de respaldo: {0} poligonos; "
                    "{1} litologias visibles."
                    .format(
                        poligonos_respaldo,
                        len(estilos_usados)
                    )
                )

                if not estilos_usados:
                    raise RuntimeError(
                        "El modelo 2D no produjo espesores geologicos "
                        "visibles. Revise la correspondencia entre "
                        "SONDEO y LITOLOGIA en el CSV."
                    )

            # Contactos geologicos interpretados.
            # Son lineas finas, continuas y limitadas a donde ambas unidades
            # mantienen un espesor representativo.
            niveles_contacto = (
                range(1, max_intervalos)
                if interpolar_geologia
                else []
            )

            for nivel_contacto in niveles_contacto:
                segmento_x = []
                segmento_y = []

                for i in range(len(grid_x)):
                    profundidad_contacto = contactos_profundidad[
                        nivel_contacto
                    ][i]

                    profundidad_control = profundidad_grid[i]

                    espesor_superior = facies_por_nivel[
                        nivel_contacto - 1
                    ][i].get("espesor", 0.0)

                    if nivel_contacto < len(facies_por_nivel):
                        espesor_inferior = facies_por_nivel[
                            nivel_contacto
                        ][i].get("espesor", 0.0)
                    else:
                        espesor_inferior = 0.0

                    estilo_superior = facies_por_nivel[
                        nivel_contacto - 1
                    ][i]["estilo"]

                    if nivel_contacto < len(facies_por_nivel):
                        estilo_inferior = facies_por_nivel[
                            nivel_contacto
                        ][i]["estilo"]
                    else:
                        estilo_inferior = estilo_superior

                    contacto_valido = (
                        profundidad_contacto > 0.45 and
                        profundidad_contacto < profundidad_control - 0.30 and
                        espesor_superior > 0.45 and
                        espesor_inferior > 0.45 and
                        estilo_superior != estilo_inferior
                    )

                    if contacto_valido:
                        segmento_x.append(grid_x[i])
                        segmento_y.append(
                            superficies_facies_y[
                                nivel_contacto
                            ][i]
                        )
                    else:
                        if len(segmento_x) >= 5:
                            ax.plot(
                                segmento_x,
                                segmento_y,
                                color="#303030",
                                linewidth=0.55,
                                linestyle="-",
                                zorder=13
                            )

                        segmento_x = []
                        segmento_y = []

                if len(segmento_x) >= 5:
                    ax.plot(
                        segmento_x,
                        segmento_y,
                        color="#303030",
                        linewidth=0.55,
                        linestyle="-",
                        zorder=13
                    )

            # Se omite la linea punteada de alcance.

            # Zona no investigada bajo el alcance de los sondeos.

            # Representacion de cuerpos de agua sobre el perfil.
            # Tanto el borde superior como el fondo siguen la geometria
            # local del perfil; no se impone un nivel horizontal artificial.
            inicio_agua = None
            agua_dibujada = False
            terreno_con_agua_y = list(terreno_y)

            for indice_agua in range(len(grid_x) + 1):
                activo = (
                    indice_agua < len(grid_x) and
                    agua_regional_grid[indice_agua]
                )

                if activo and inicio_agua is None:
                    inicio_agua = indice_agua

                if not activo and inicio_agua is not None:
                    fin_tramo_agua = indice_agua - 1

                    if fin_tramo_agua - inicio_agua >= 0:
                        xs_agua = grid_x[
                            inicio_agua:fin_tramo_agua + 1
                        ]
                        superficie_agua = terreno_y[
                            inicio_agua:fin_tramo_agua + 1
                        ]

                        # Si el cuerpo solo alcanza una muestra, se
                        # representa con un ancho grafico minimo para que
                        # no desaparezca por la resolucion del perfil.
                        if len(xs_agua) == 1:
                            centro_agua = xs_agua[0]
                            medio_ancho_agua = max(
                                paso * 0.55,
                                longitud_real * 0.00035
                            )
                            inicio_visual_agua = max(
                                x_inicio,
                                centro_agua - medio_ancho_agua
                            )
                            fin_visual_agua = min(
                                x_fin,
                                centro_agua + medio_ancho_agua
                            )

                            if fin_visual_agua <= inicio_visual_agua:
                                fin_visual_agua = min(
                                    x_fin,
                                    inicio_visual_agua +
                                    max(paso, 0.5)
                                )

                            xs_agua = [
                                inicio_visual_agua,
                                centro_agua,
                                fin_visual_agua
                            ]
                            superficie_agua = [
                                (
                                    terreno_en_x(x_agua) -
                                    base_horizontal
                                ) * ev
                                for x_agua in xs_agua
                            ]

                        cantidad_puntos_agua = len(xs_agua)
                        fondo_agua = []

                        # El espesor grafico se adapta al relieve y se
                        # desvanece suavemente en ambos extremos.
                        rango_relieve = max(
                            superficie_agua
                        ) - min(
                            superficie_agua
                        )

                        ancho_tramo_agua = max(
                            abs(
                                xs_agua[-1] -
                                xs_agua[0]
                            ),
                            paso
                        )

                        # El espesor aumenta con el ancho real del cuerpo
                        # de agua, pero queda limitado para no exagerarlo.
                        profundidad_agua_m = max(
                            1.80,
                            min(
                                7.00,
                                1.10 +
                                0.10 *
                                math.sqrt(
                                    max(
                                        ancho_tramo_agua,
                                        0.0
                                    )
                                ) +
                                min(
                                    0.90,
                                    0.10 *
                                    rango_relieve /
                                    max(ev, 0.000001)
                                )
                            )
                        )

                        espesor_central = (
                            profundidad_agua_m * ev
                        )

                        msg_local(
                            "Cuerpo de agua: ancho {0:.1f} m; "
                            "profundidad visual {1:.2f} m."
                            .format(
                                ancho_tramo_agua,
                                profundidad_agua_m
                            )
                        )

                        for indice_local in range(cantidad_puntos_agua):
                            if cantidad_puntos_agua <= 1:
                                fraccion = 0.5
                            else:
                                fraccion = (
                                    indice_local /
                                    float(cantidad_puntos_agua - 1)
                                )

                            forma_parabolica = (
                                4.0 * fraccion *
                                (1.0 - fraccion)
                            )

                            # Conservar espesor visible en las orillas y
                            # mayor profundidad hacia el centro.
                            forma_cauce = (
                                0.28 +
                                0.72 *
                                forma_parabolica
                            )

                            fondo_agua.append(
                                superficie_agua[indice_local] -
                                espesor_central * forma_cauce
                            )

                        ax.fill_between(
                            xs_agua,
                            superficie_agua,
                            fondo_agua,
                            facecolor="#79BCE8",
                            edgecolor="#2D78A6",
                            linewidth=0.75,
                            alpha=0.94,
                            zorder=18
                        )

                        # El contorno del agua coincide con la superficie
                        # topografica original del tramo.
                        ax.plot(
                            xs_agua,
                            superficie_agua,
                            color="#2D78A6",
                            linewidth=0.95,
                            zorder=20
                        )

                        agua_dibujada = True

                    inicio_agua = None

            # Dibujar el perfil superficial final conservando sus contornos.
            ax.plot(
                grid_x,
                terreno_y,
                color="#202020",
                linewidth=0.9,
                zorder=21
            )

            nivel_freatico_dibujado = _dibujar_nivel_freatico(
                ax,
                linea,
                grid_x,
                terreno,
                terreno_y,
                espesores_grid,
                unidades_geologicas,
                agua_regional_grid,
                base_horizontal,
                ev,
                radio,
                profundidad_interpretacion,
                msg_local
            )

            controles_ordenados_etiqueta = sorted(
                list(enumerate(controles)),
                key=lambda par: par[1]["x"]
            )
            niveles_etiqueta = {}
            ultimo_x_por_nivel = {}
            separacion_minima_etiqueta = max(
                longitud_real * 0.055,
                550.0
            )
            max_niveles_etiqueta = 5

            for indice_original, control_etiqueta in (
                controles_ordenados_etiqueta
            ):
                x_etiqueta_control = control_etiqueta["x"]
                nivel_elegido = None

                for nivel_candidato in range(
                    max_niveles_etiqueta
                ):
                    ultimo_x = ultimo_x_por_nivel.get(
                        nivel_candidato
                    )

                    if (
                        ultimo_x is None or
                        x_etiqueta_control - ultimo_x >=
                        separacion_minima_etiqueta
                    ):
                        nivel_elegido = nivel_candidato
                        break

                if nivel_elegido is None:
                    nivel_elegido = (
                        indice_original %
                        max_niveles_etiqueta
                    )

                niveles_etiqueta[indice_original] = (
                    nivel_elegido
                )
                ultimo_x_por_nivel[nivel_elegido] = (
                    x_etiqueta_control
                )

            for idx, control in enumerate(controles):
                x = control["x"]

                # La boca y etiqueta usan la elevacion real del sondeo.
                z_boca_perfil = float(
                    control["elevacion"]
                )
                z_fondo_perfil = (
                    z_boca_perfil -
                    control["profundidad"]
                )

                boca_y = (
                    z_boca_perfil -
                    base_horizontal
                ) * ev

                fondo_y = (
                    z_fondo_perfil -
                    base_horizontal
                ) * ev

                # Columna rectangular tipo barreno minero.
                ancho_barreno = max(
                    120.0,
                    (x_fin - x_inicio) * 0.0040
                )

                rectangulo_barreno = plt.Rectangle(
                    (
                        x - ancho_barreno / 2.0,
                        fondo_y
                    ),
                    ancho_barreno,
                    boca_y - fondo_y,
                    facecolor="none",
                    edgecolor="#1F1F1F",
                    linewidth=0.65,
                    alpha=1.0,
                    zorder=88
                )

                ax.add_patch(
                    rectangulo_barreno
                )

                # Linea central del barreno y collar.
                ax.plot(
                    [x, x],
                    [boca_y, fondo_y],
                    color="#4A4A4A",
                    linewidth=0.45,
                    zorder=90
                )

                ax.plot(
                    [
                        x - ancho_barreno * 0.62,
