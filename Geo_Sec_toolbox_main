# Exportacion de reportes Excel


def _excel_columna(numero):
    resultado = ""
    numero = int(numero)

    while numero > 0:
        numero, residuo = divmod(numero - 1, 26)
        resultado = chr(65 + residuo) + resultado

    return resultado


def _xml_excel(valor):
    texto = texto_unicode(valor)

    return (
        texto.replace(u"&", u"&amp;")
        .replace(u"<", u"&lt;")
        .replace(u">", u"&gt;")
        .replace(u'"', u"&quot;")
        .replace(u"'", u"&apos;")
    )


def escribir_xlsx_control_con_graficos(
    ruta_xlsx,
    encabezados,
    filas_control,
    resumenes,
    total_puntos
