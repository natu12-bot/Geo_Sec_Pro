            campo_nombre = buscar_columna_csv(
                encabezados_csv,
                ["NOMBRE"]
            )
            campo_x = buscar_columna_csv(
                encabezados_csv,
                ["X", "COORD_X", "ESTE"]
            )
            campo_y = buscar_columna_csv(
                encabezados_csv,
                ["Y", "COORD_Y", "NORTE"]
            )
            campo_z = buscar_columna_csv(
                encabezados_csv,
                ["Z", "ELEVACION", "COTA"]
            )
            campo_prof = buscar_columna_csv(
                encabezados_csv,
                [
                    "PROFUNDIDA",
                    "PROFUNDIDAD",
                    "PROFUNDI_1",
