    """
    Crea un XLSX con una hoja de control y tres hojas de resumen,
    cada una con un grafico circular incrustado.
    """
    if os.path.exists(ruta_xlsx):
        try:
            os.remove(ruta_xlsx)
        except Exception:
            pass

    def celda_xml(ref, valor, estilo=0):
        es_numero = (
            isinstance(valor, (int, long, float)) and
            not isinstance(valor, bool)
        )

        if es_numero:
            return (
                u'<c r="{0}" s="{1}" t="n"><v>{2}</v></c>'
                .format(ref, estilo, texto_unicode(valor))
            )

        return (
            u'<c r="{0}" s="{1}" t="inlineStr">'
            u'<is><t xml:space="preserve">{2}</t></is></c>'
            .format(ref, estilo, _xml_excel(valor))
        )

    def hoja_datos(
        filas,
        con_dibujo=False,
        es_resumen=False
    ):
        xml_filas = []

        for i, fila in enumerate(filas):
            numero_fila = i + 1
            celdas = []

            for j, valor in enumerate(fila):
                referencia = "{0}{1}".format(
                    _excel_columna(j + 1),
                    numero_fila
                )

                if i == 0:
                    estilo = 1
                elif es_resumen and j == 1:
                    estilo = 2
                elif es_resumen and j == 2:
                    estilo = 3
                elif es_resumen:
                    estilo = 4
                else:
                    estilo = 0

                celdas.append(
                    celda_xml(
                        referencia,
                        valor,
                        estilo
                    )
                )

            altura = (
                u' ht="22" customHeight="1"'
                if i == 0
                else u' ht="19" customHeight="1"'
            )

            xml_filas.append(
                u'<row r="{0}"{1}>{2}</row>'.format(
                    numero_fila,
                    altura,
                    u"".join(celdas)
                )
            )

        dibujo = (
            u'<drawing r:id="rId1"/>'
            if con_dibujo
            else u""
        )

        return (
            u'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            u'<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
            u'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'
            u'<sheetViews><sheetView workbookViewId="0">'
            u'<pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/>'
            u'</sheetView></sheetViews>'
