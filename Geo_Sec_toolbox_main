            def dominante_sondeo(control, desde_banda, hasta_banda):
                acumulado = {}

                for intervalo in control["intervalos_exactos"]:
                    solape = max(
                        0.0,
                        min(intervalo["hasta"], hasta_banda) -
                        max(intervalo["desde"], desde_banda)
