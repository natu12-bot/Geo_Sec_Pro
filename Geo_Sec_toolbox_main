        def interpretar_codigo_2d(codigo):
            valor = normalizar(codigo).upper().replace(" ", "")

            if valor.startswith("LUT") or valor.startswith("LU"):
                return "Lutita gris"
            if valor.startswith("AR"):
                return "Arena de grano fino"
            if valor.startswith("GR"):
                return "Gravas"
            if valor.startswith("CG"):
                return "Conglomerado"
            if valor.startswith("MO") or "ORG" in valor:
                return "Material organico"
            if valor.startswith("ARC"):
                return "Arcilla"

            return texto_unicode(codigo).strip() or "Otra litologia"

        def texto_id_fuente(valor):
            if valor is None:
                return ""

            texto = texto_unicode(valor).strip()

            try:
                numero = float(
                    texto.replace(",", ".")
                )

                if abs(numero - round(numero)) < 0.000001:
                    return str(int(round(numero)))

                return (
                    "{0:.6f}".format(numero)
                    .rstrip("0")
                    .rstrip(".")
                )
            except Exception:
                return normalizar(texto).replace(" ", "")

        def clave_linea_punto(linea_valor, punto_valor):
            linea_texto = texto_id_fuente(linea_valor)
            punto_texto = texto_id_fuente(punto_valor)

            if not linea_texto or not punto_texto:
                return ""

            return linea_texto + "|" + punto_texto

        def litologia_matriz_valida(valor):
            texto = texto_unicode(valor).strip()

            if not texto:
                return ""

            normal = normalizar(texto)
            compacto = re.sub(
                ur"[^a-z0-9]+",
                "",
                normal
            )

            if normal in (
                "ninguno",
                "ninguna",
                "sin informacion",
                "sin datos",
                "no aplica",
                "n a",
                "na",
                "-"
            ):
                return ""

            # Normalizacion directa antes de cualquier clasificacion.
            # Toda variante de ARENISCA o codigo 3 se representa como Arena.
            if (
                "arenisc" in compacto or
                compacto.startswith("aren") or
                compacto in ("ar", "3")
            ):
                return "Arena de grano fino"

            if (
                "lutita" in compacto or
                compacto.startswith("lut") or
                compacto in ("lu", "4")
            ):
                return "Lutita gris"

            if (
                "grava" in compacto or
                compacto.startswith("gr") or
                compacto in ("5",)
            ):
                return "Gravas"

            if (
                "arcilla" in compacto or
                compacto.startswith("arc") or
                compacto in ("1",)
            ):
                return "Arcilla"

            return texto

        def construir_intervalos_matriz(
            lito_0_10,
            lito_10_18,
            lito_18_28,
            profundidad_total
        ):
            profundidad_total = float(profundidad_total)

            bandas = [
                (0.0, 10.0, lito_0_10),
                (10.0, 18.0, lito_10_18),
                (18.0, 28.0, lito_18_28)
            ]

            intervalos = []

            for desde, hasta, valor_lito in bandas:
                nombre = litologia_matriz_valida(
                    valor_lito
                )

                if not nombre:
                    continue

                desde_real = max(0.0, desde)
                hasta_real = min(
                    profundidad_total,
                    hasta
                )

                if hasta_real <= desde_real:
                    continue

                estilo = clave_estilo_litologia(
                    nombre
                )

                if estilo not in ESTILOS_LITOLOGIA:
                    estilo = "otro"

                etiqueta = ESTILOS_LITOLOGIA[
                    estilo
                ]["etiqueta"]

                intervalos.append({
                    "desde": desde_real,
                    "hasta": hasta_real,
                    "unidad": clasificar_litologia(
                        etiqueta
                    ),
                    "litologia": etiqueta
                })

            return intervalos

        try:
            cantidad = int(
                arcpy.GetCount_management(
                    linea_3d
                ).getOutput(0)
            )

            if cantidad != 1:
                raise ValueError(
                    "La linea 3D debe contener exactamente una entidad."
                )

            with arcpy.da.SearchCursor(
                linea_3d,
                ["SHAPE@"]
            ) as cursor:
                linea = next(cursor)[0]

            linea = _orientar_linea_oeste_este(
                linea
            )

            msg_local(
                "Sentido del perfil: Oeste a Este."
            )

            # Orientacion calculada con la tendencia completa de la
            # linea y expresada como rumbo respecto al norte.
            orientacion_ap, orientacion_a, azimut_linea = (
                _orientacion_real_linea(linea)
            )
            rumbo_derecha = _direccion_cardinal_8(
                azimut_linea
            )
            rumbo_izquierda = _direccion_cardinal_8(
                azimut_linea + 180.0
            )

            msg_local(
                "Rumbo real: {0} - {1}; azimut {2:.1f} grados."
                .format(
                    orientacion_ap,
                    orientacion_a,
                    azimut_linea
                )
            )

            msg_local("Etapa 1/6: extrayendo perfil topografico...")

            perfil = []
            distancia = 0.0
            anterior = None

            for parte in linea:
                for punto in parte:
                    if punto is None:
                        continue

                    try:
                        z = float(punto.Z)
                    except Exception:
                        continue

                    if z != z:
                        continue

                    if anterior is not None:
                        dx = punto.X - anterior.X
                        dy = punto.Y - anterior.Y

                        distancia += math.sqrt(
                            dx * dx + dy * dy
                        )

                    perfil.append(
                        (distancia, z)
                    )

                    anterior = punto

            if len(perfil) < 2:
                raise RuntimeError(
                    "La linea no contiene suficientes valores Z."
                )

            perfil_x = [r[0] for r in perfil]

            # Se conservan los Z originales de la linea.
            # El suavizado topografico configurable se aplica una sola vez.
            perfil_z = [
                r[1] for r in perfil
            ]

            msg_local(
                "Etapa 2/6: leyendo puntos y litologia desde el CSV..."
            )

            if not archivo_csv_litologias:
                raise RuntimeError(
                    "No se proporciono el CSV de litologia 2D."
