class SeccionesFactibilidadLote(SeccionFactibilidad):
    def __init__(self):
        self.label = "Generar varias secciones - Factibilidad"
        self.description = (
            "Procesa todas las lineas o solo las seleccionadas con "
            "la misma escala y configuracion."
        )

    def getParameterInfo(self):
        parametros = super(SeccionesFactibilidadLote, self).getParameterInfo()
        parametros[0].displayName = "Capa de lineas 3D de seccion"
        parametros[4].enabled = False
        parametros[5].enabled = False

        p = arcpy.Parameter(
            displayName="Lineas a procesar",
            name="lineas_procesar",
            datatype="GPString",
            parameterType="Required",
            direction="Input"
        )
        p.filter.type = "ValueList"
        p.filter.list = ["Todas", "Solo seleccionadas"]
        p.value = "Todas"
        parametros.append(p)

        p = arcpy.Parameter(
            displayName="Campo con nombre de seccion",
            name="campo_nombre",
            datatype="Field",
            parameterType="Optional",
            direction="Input"
        )
        p.parameterDependencies = [parametros[0].name]
        parametros.append(p)

        for parametro in parametros:
            if parametro.name == "longitud_barra":
                parametro.enabled = False
                parametro.displayName = (
                    "Barra grafica automatica"
                )
                break

        return parametros

    def execute(self, parameters, messages):
        lineas = parameters[0].valueAsText
        modo = texto_unicode(parameters[-2].valueAsText).strip().lower()
        campo_nombre = parameters[-1].valueAsText

        oid = arcpy.Describe(lineas).OIDFieldName
        campos = [oid, "SHAPE@"]
        if campo_nombre:
            campos.append(campo_nombre)

        capa_base = arcpy.MakeFeatureLayer_management(
            lineas,
            "lineas_factibilidad_lote"
        ).getOutput(0)

        if modo == "solo seleccionadas":
            try:
                capa_original = arcpy.mapping.Layer(lineas)
                if capa_original.getSelectionSet():
