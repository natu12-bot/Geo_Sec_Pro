            float(parametro_inferior.value)
        ):
            parametro_superior.setErrorMessage(
                "La elevacion superior debe ser mayor "
                "que la elevacion inferior."
            )

        if (
            "mostrar_nivel_freatico" in nombres and
            _valor_bool(
                parameters[
                    nombres.index("mostrar_nivel_freatico")
                ]
            ) and
            "metodo_nivel_freatico" in nombres
        ):
            metodo_nf = normalizar_texto(
                parameters[
                    nombres.index("metodo_nivel_freatico")
                ].valueAsText
            )

            if metodo_nf == "solo observado":
                parametro_puntos_nf = parameters[
                    nombres.index("puntos_nivel_freatico")
                ]
                parametro_campo_nf = parameters[
                    nombres.index("campo_nivel_freatico")
                ]

                if not parametro_puntos_nf.valueAsText:
                    parametro_puntos_nf.setErrorMessage(
                        "Solo observado requiere una capa de puntos "
                        "con nivel freatico medido."
                    )

                if not parametro_campo_nf.valueAsText:
                    parametro_campo_nf.setErrorMessage(
                        "Indique el campo de profundidad al nivel "
                        "freatico en metros."
                    )

        return


def _estadisticas_lineas(capa_lineas):
    """
    Devuelve longitud maxima, elevacion maxima y elevacion minima
    de una capa de lineas Z. El mismo calculo se utiliza para
    Factibilidad y Perfil 2D.
    """
    longitud_maxima = 0.0
    elevacion_maxima = None
    elevacion_minima = None

    with arcpy.da.SearchCursor(
        capa_lineas,
        ["SHAPE@"]
    ) as cursor:
        for fila in cursor:
            geometria = fila[0]

            if geometria is None:
                continue

            try:
                longitud_maxima = max(
                    longitud_maxima,
                    float(geometria.length)
                )
            except Exception:
                pass

            for parte in geometria:
                for punto in parte:
                    if punto is None:
                        continue

                    try:
                        z = float(punto.Z)
                    except Exception:
                        continue

                    if z != z:
                        continue

                    if (
                        elevacion_maxima is None or
                        z > elevacion_maxima
                    ):
                        elevacion_maxima = z

                    if (
                        elevacion_minima is None or
                        z < elevacion_minima
                    ):
                        elevacion_minima = z

    return (
        longitud_maxima,
        elevacion_maxima,
        elevacion_minima
    )


def _redondear_barra_grafica(
    longitud_propuesta,
    divisiones,
    longitud_maxima
):
    """
    Redondea solo la barra grafica. No altera EH, EV, los limites
    del perfil ni el tamano de la imagen.
    """
    divisiones = max(1, int(divisiones))
    longitud_maxima = max(0.001, float(longitud_maxima))
    longitud_propuesta = max(
        0.001,
        min(float(longitud_propuesta), longitud_maxima)
    )

    division_objetivo = (
        longitud_propuesta /
        float(divisiones)
    )
    exponente = math.floor(
        math.log10(
            max(division_objetivo, 0.000001)
        )
    )
    base = 10.0 ** exponente
    candidatos = []

    for desplazamiento in (-1, 0, 1, 2):
        base_local = base * (10.0 ** desplazamiento)

        for factor in (1.0, 2.0, 2.5, 5.0):
            division = factor * base_local
            total = division * divisiones

            if total <= longitud_maxima + 0.000001:
                candidatos.append(
                    (abs(total - longitud_propuesta), total)
                )

    if not candidatos:
        return longitud_propuesta

    candidatos.sort(
        key=lambda elemento: (
            elemento[0],
            -elemento[1]
        )
    )
    return candidatos[0][1]


def _longitud_barra_automatica(longitud):
    objetivo = max(
        float(longitud) * 0.25,
        1.0
    )
    exponente = math.floor(
        math.log10(objetivo)
    )
    base = 10.0 ** exponente
    opciones = [
        1.0 * base,
        2.0 * base,
        5.0 * base,
        10.0 * base
    ]
    return min(
        opciones,
        key=lambda valor: abs(
            valor - objetivo
        )
    )


def _redondear_longitud_marco(longitud):
    """
    Redondea hacia arriba usando pasos cartograficos legibles.
    """
    longitud = max(1.0, float(longitud))

    pasos = [
        100.0,
        200.0,
        500.0,
        1000.0,
        2000.0,
        5000.0,
        10000.0
    ]

    paso = pasos[-1]

    for candidato in pasos:
        cantidad = longitud / candidato

        if 4.0 <= cantidad <= 10.0:
            paso = candidato
            break

    return math.ceil(
        longitud / paso
    ) * paso


def _aplicar_escala_comun_lote(
    parametros,
    capa_lineas,
    profundidad,
    inicio_comunes
):
    """
    Prepara las referencias comparables del lote y calcula una
    unica barra grafica automatica para todas sus secciones.
    """
    longitud_maxima, z_maxima, z_minima = _estadisticas_lineas(
        capa_lineas
    )

    longitudes_lote = []

    try:
        with arcpy.da.SearchCursor(
            capa_lineas,
            ["SHAPE@LENGTH"]
        ) as cursor_longitudes:
            for fila_longitud in cursor_longitudes:
                longitud_valida = float(
                    fila_longitud[0] or 0.0
                )

                if longitud_valida > 0.0:
                    longitudes_lote.append(
                        longitud_valida
                    )
    except Exception:
        longitudes_lote = []

    longitud_minima = (
        min(longitudes_lote)
        if longitudes_lote
        else longitud_maxima
    )

    longitud_comun = _redondear_longitud_marco(
        longitud_maxima
    )

    nombres = [
        p.name
        for p in parametros
    ]

    parametros_requeridos = [
        "longitud_marco",
        "rango_vertical_referencia",
        "margen_superior",
        "modo_escala_grafica",
        "modo_vertical",
        "elevacion_superior",
        "elevacion_inferior",
        "longitud_barra"
    ]

    faltantes = [
        nombre_parametro
        for nombre_parametro in parametros_requeridos
        if nombre_parametro not in nombres
    ]

    if faltantes:
        raise RuntimeError(
            "Faltan parametros de escala en el lote: " +
            ", ".join(faltantes)
        )

    indice_longitud = nombres.index(
        "longitud_marco"
    )
    indice_rango_vertical = nombres.index(
        "rango_vertical_referencia"
    )
    indice_margen = nombres.index(
        "margen_superior"
    )
    indice_modo_escala = nombres.index(
        "modo_escala_grafica"
    )
    indice_modo_vertical = nombres.index(
        "modo_vertical"
    )
    indice_elevacion_superior = nombres.index(
        "elevacion_superior"
    )
    indice_elevacion_inferior = nombres.index(
        "elevacion_inferior"
    )
    indice_longitud_barra = nombres.index(
        "longitud_barra"
    )

    longitud_usuario = float(
        parametros[indice_longitud].value or 0.0
    )
    rango_usuario = float(
        parametros[indice_rango_vertical].value or 0.0
    )
    margen = float(
        parametros[indice_margen].value or 10.0
    )

    modo_horizontal = normalizar_texto(
        parametros[indice_modo_escala].valueAsText
    )
    modo_vertical = normalizar_texto(
        parametros[indice_modo_vertical].valueAsText
    )

    if modo_horizontal == "personalizada":
        referencia_horizontal = max(
            1.0,
            longitud_usuario
        )
        parametros[indice_modo_escala] = _ParametroInterno(
            "Personalizada"
        )
        parametros[indice_longitud] = _ParametroInterno(
            referencia_horizontal
        )
    elif modo_horizontal == "misma para todas":
        referencia_horizontal = (
            longitud_usuario
            if longitud_usuario > 0.0
            else longitud_comun
        )
        parametros[indice_modo_escala] = _ParametroInterno(
            "Misma para todas"
        )
        parametros[indice_longitud] = _ParametroInterno(
            referencia_horizontal
        )
    else:
        referencia_horizontal = 0.0
        parametros[indice_modo_escala] = _ParametroInterno(
            "Automatica"
        )
        parametros[indice_longitud] = _ParametroInterno(
            0.0
        )

    superior_referencia = (
        z_maxima + margen
        if z_maxima is not None
        else margen
    )
    inferior_referencia = (
        (z_minima - float(profundidad))
        if z_minima is not None
        else -float(profundidad)
    )
    rango_comun = max(
        10.0,
        superior_referencia - inferior_referencia
    )

    if modo_vertical == "personalizada":
        superior_usuario = parametros[
            indice_elevacion_superior
        ].value
        inferior_usuario = parametros[
            indice_elevacion_inferior
        ].value

        usar_limites_usuario = (
            superior_usuario is not None and
            inferior_usuario is not None and
            float(superior_usuario) >
            float(inferior_usuario)
        )

        if usar_limites_usuario:
            rango_personalizado = (
                float(superior_usuario) -
                float(inferior_usuario)
            )
        else:
            superior_usuario = None
            inferior_usuario = None
            rango_personalizado = (
                rango_usuario
                if rango_usuario > 0.0
                else rango_comun
            )

        parametros[indice_modo_vertical] = _ParametroInterno(
            "Personalizada"
        )
        parametros[indice_rango_vertical] = _ParametroInterno(
            max(1.0, rango_personalizado)
        )
        parametros[indice_elevacion_superior] = _ParametroInterno(
            superior_usuario
        )
        parametros[indice_elevacion_inferior] = _ParametroInterno(
            inferior_usuario
        )
    elif modo_vertical == "misma para todas":
        superior_usuario = parametros[
            indice_elevacion_superior
        ].value
        inferior_usuario = parametros[
            indice_elevacion_inferior
        ].value

        usar_limites_usuario = (
            superior_usuario is not None and
            inferior_usuario is not None and
            float(superior_usuario) >
            float(inferior_usuario)
        )

        if usar_limites_usuario:
            superior_aplicado = float(superior_usuario)
            inferior_aplicado = float(inferior_usuario)
            rango_aplicado = (
                superior_aplicado -
                inferior_aplicado
            )
        else:
            superior_aplicado = superior_referencia
            inferior_aplicado = inferior_referencia
            rango_aplicado = rango_comun

        parametros[indice_modo_vertical] = _ParametroInterno(
            "Misma para todas"
        )
        parametros[indice_rango_vertical] = _ParametroInterno(
            rango_aplicado
        )
        parametros[indice_elevacion_superior] = _ParametroInterno(
            superior_aplicado
        )
        parametros[indice_elevacion_inferior] = _ParametroInterno(
            inferior_aplicado
        )
    else:
        parametros[indice_modo_vertical] = _ParametroInterno(
            "Automatica"
        )
        parametros[indice_rango_vertical] = _ParametroInterno(
            0.0
        )
        parametros[indice_elevacion_superior] = _ParametroInterno(
            None
        )
        parametros[indice_elevacion_inferior] = _ParametroInterno(
            None
        )

    # La barra del lote se calcula con la misma referencia
    # horizontal usada para comparar las secciones. No depende de
    # la linea mas corta ni se recalcula para cada imagen.
    if referencia_horizontal > 0.0:
        limite_barra = max(
            1.0,
            referencia_horizontal
        )
    else:
        limite_barra = max(
            1.0,
            longitud_comun
        )

    barra_comun = _longitud_barra_automatica(
        limite_barra
    )
    barra_comun = _redondear_barra_grafica(
        barra_comun,
        5,
        limite_barra
    )

    parametros[indice_longitud_barra] = _ParametroInterno(
        barra_comun
    )

    arcpy.AddMessage(
        "Barra grafica automatica del lote: {0:.1f} m."
        .format(barra_comun)
    )

    valor_horizontal = float(
        parametros[indice_longitud].value or 0.0
    )
    valor_vertical = float(
        parametros[indice_rango_vertical].value or 0.0
    )

    if valor_horizontal > 0.0:
        arcpy.AddMessage(
            "Referencia horizontal comun del lote: {0:.0f} m."
            .format(valor_horizontal)
        )
    else:
        arcpy.AddMessage(
            "Escala horizontal: automatica por seccion."
        )

    if valor_vertical > 0.0:
        arcpy.AddMessage(
            "Referencia vertical comun del lote: {0:.1f} m."
            .format(valor_vertical)
        )
    else:
        arcpy.AddMessage(
            "Escala vertical: automatica por seccion."
        )

    return parametros


def _direccion_cardinal_8(azimut):
    """
    Devuelve solo letras cardinales, sin angulos:
    N, NE, E, SE, S, SW, W o NW.
    """
    azimut = float(azimut) % 360.0
    indice = int(
        round(azimut / 45.0)
    ) % 8

    return [
        "N", "NE", "E", "SE",
        "S", "SW", "W", "NW"
    ][indice]


def _envolver_texto_leyenda(valor, maximo):
    """
    Divide etiquetas largas sin permitir que salgan del panel.
    """
    texto = texto_unicode(valor).strip()

    if len(texto) <= maximo:
        return texto

    palabras = texto.split()
    lineas = []
    linea = ""

    for palabra in palabras:
        propuesta = (
            palabra
            if not linea
            else linea + " " + palabra
        )

        if len(propuesta) <= maximo:
            linea = propuesta
        else:
            if linea:
                lineas.append(linea)
            linea = palabra

    if linea:
        lineas.append(linea)

    return "\n".join(lineas)


def _orientar_linea_oeste_este(linea):
    """
    Coloca como inicio el extremo mas occidental para que el perfil
    siempre se lea de izquierda a derecha, de oeste hacia este.
    """
    if linea is None:
        return linea

    try:
        primero = linea.firstPoint
        ultimo = linea.lastPoint
    except Exception:
        return linea

    if primero is None or ultimo is None:
        return linea

    if float(primero.X) <= float(ultimo.X) + 0.001:
        return linea

    try:
        partes = []

        for parte in linea:
            puntos = []

            for punto in parte:
                if punto is None:
                    continue

                nuevo = arcpy.Point()
                nuevo.X = punto.X
                nuevo.Y = punto.Y

                try:
                    nuevo.Z = punto.Z
                except Exception:
                    pass

                try:
                    nuevo.M = punto.M
                except Exception:
                    pass

                puntos.append(nuevo)

            if puntos:
                partes.append(puntos)

        arreglo_total = arcpy.Array()

        for puntos in reversed(partes):
            arreglo_parte = arcpy.Array()

            for punto in reversed(puntos):
                arreglo_parte.add(punto)

            arreglo_total.add(arreglo_parte)

        return arcpy.Polyline(
            arreglo_total,
            linea.spatialReference,
            bool(getattr(linea, "hasZ", True)),
            bool(getattr(linea, "hasM", False))
        )

    except Exception:
        return linea


def _rumbo_cuadrantal_desde_azimut(azimut):
    """
    Convierte azimut medido desde el norte, en sentido horario,
    a rumbo cuadrantal.
    """
    azimut = float(azimut) % 360.0

    if azimut <= 90.0:
        return "N {0:.0f} E".format(azimut)
    if azimut <= 180.0:
        return "S {0:.0f} E".format(180.0 - azimut)
    if azimut <= 270.0:
        return "S {0:.0f} W".format(azimut - 180.0)

    return "N {0:.0f} W".format(360.0 - azimut)


def _orientacion_real_linea(linea):
    """
    Calcula la orientacion general usando todos los vertices de la linea,
    no solo el primero y el ultimo. La tendencia principal se obtiene
    mediante el eje de mayor varianza y se expresa respecto al norte.

    Devuelve:
      rumbo_izquierdo, rumbo_derecho, azimut_derecho
    """
    puntos = []

    for parte in linea:
        for punto in parte:
            if punto is not None:
                puntos.append(
                    (float(punto.X), float(punto.Y))
                )

    if len(puntos) < 2:
        return "N 0 E", "S 0 W", 0.0

    media_x = sum(p[0] for p in puntos) / float(len(puntos))
    media_y = sum(p[1] for p in puntos) / float(len(puntos))

    var_x = sum(
        (p[0] - media_x) ** 2
        for p in puntos
    ) / float(len(puntos))
    var_y = sum(
        (p[1] - media_y) ** 2
        for p in puntos
    ) / float(len(puntos))
    cov_xy = sum(
        (p[0] - media_x) * (p[1] - media_y)
        for p in puntos
    ) / float(len(puntos))

    angulo_eje = 0.5 * math.atan2(
        2.0 * cov_xy,
        var_x - var_y
    )

    dx = math.cos(angulo_eje)
    dy = math.sin(angulo_eje)

    # Ajustar el signo del eje para que coincida con el sentido visual
    # de la linea en el perfil, usando la proyeccion acumulada completa.
    proyeccion_inicio = (
        (puntos[0][0] - media_x) * dx +
        (puntos[0][1] - media_y) * dy
    )
    proyeccion_fin = (
        (puntos[-1][0] - media_x) * dx +
        (puntos[-1][1] - media_y) * dy
    )

    if proyeccion_fin < proyeccion_inicio:
        dx = -dx
        dy = -dy

    azimut_derecho = math.degrees(
        math.atan2(dx, dy)
    )

    if azimut_derecho < 0.0:
        azimut_derecho += 360.0

    azimut_izquierdo = (
        azimut_derecho + 180.0
    ) % 360.0

    return (
        _rumbo_cuadrantal_desde_azimut(
            azimut_izquierdo
        ),
        _rumbo_cuadrantal_desde_azimut(
            azimut_derecho
        ),
        azimut_derecho
    )


