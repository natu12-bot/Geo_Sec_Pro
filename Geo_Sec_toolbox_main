    def updateMessages(self, parameters):
        positivos = [
            7, 8, 9, 10, 11, 13,
            14, 15, 17
        ]

        for idx in positivos:
            if parameters[idx].value is not None:
                if float(parameters[idx].value) <= 0:
                    parameters[idx].setErrorMessage(
                        "El valor debe ser mayor que cero."
                    )

        if parameters[12].value is not None:
            if int(parameters[12].value) < 0:
                parameters[12].setErrorMessage(
                    "Las iteraciones no pueden ser negativas."
                )

        if parameters[16].value is not None:
            if float(parameters[16].value) < 0:
                parameters[16].setErrorMessage(
                    "Use 0 para escala automatica o un valor positivo."
                )

        if parameters[21].value is not None:
            if float(parameters[21].value) <= 0:
                parameters[21].setErrorMessage(
                    "La potencia debe ser mayor que cero."
                )

        return

