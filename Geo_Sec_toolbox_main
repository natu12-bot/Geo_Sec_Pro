                return None

            def abrir_csv_compatible(ruta_csv):
                codificaciones = [
                    "utf-8-sig",
                    "utf-8",
                    "cp1252",
                    "latin-1"
                ]

                ultimo_error = None

                for codificacion in codificaciones:
                    try:
                        archivo = open(ruta_csv, "rb")
                        contenido = archivo.read()
                        archivo.close()

                        return contenido.decode(
                            codificacion
                        ), codificacion
                    except Exception as exc:
                        ultimo_error = exc

                raise RuntimeError(
                    "No fue posible leer el CSV: {0}".format(
                        ultimo_error
                    )
                )

            contenido_csv, codificacion_csv = abrir_csv_compatible(
                archivo_csv_litologias
            )

            lineas_csv = contenido_csv.splitlines()

            if not lineas_csv:
                raise RuntimeError(
                    "El CSV esta vacio."
                )

            delimitadores = [";", ",", "\t", "|"]
            delimitador_csv = max(
                delimitadores,
                key=lambda delimitador: lineas_csv[0].count(
                    delimitador
                )
            )

            try:
                import StringIO
