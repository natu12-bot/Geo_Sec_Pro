        def clasificar_organico_directo(nombre):
            """
            Clasificacion prioritaria sobre el texto original.

            No depende de la eliminacion de acentos. Las raices 'org',
            'calc', 'resid' y 'carbon' permanecen reconocibles aunque
            ArcMap lea el CSV con UTF-8, CP1252 o caracteres danados.
            """
            bruto = texto_unicode(nombre).lower()

            # Separar signos para facilitar la deteccion de abreviaciones.
            for separador in [
                u"-", u"_", u"/", u"\\", u",", u";",
                u":", u".", u"(", u")", u"[", u"]"
            ]:
                bruto = bruto.replace(separador, u" ")

            bruto = u" ".join(bruto.split())

            es_organico = (
                u"org" in bruto or
                u"vegetal" in bruto or
                u"materia vegetal" in bruto
            )

            if not es_organico:
                return None

            return "material organico"

        def clave_estilo_litologia(nombre):
            clave_organica = clasificar_organico_directo(
                nombre
            )

            if clave_organica:
                return clave_organica

            valor = normalizar(nombre)

            # MATERIAL ORGANICO: REGLA PRIORITARIA Y TOLERANTE
            # Las raices permiten reconocer acentos danados, abreviaciones,
            # plurales y textos como "material organico c/res. calcareos".
            tokens = valor.split()

            tiene_organico = (
                any(
                    token.startswith("org")
                    for token in tokens
                ) or
                (
                    "material" in tokens and
                    any(
                        token.startswith("orga")
                        for token in tokens
                    )
                ) or
                "vegetal" in tokens
            )

            tiene_residuo = any(
                token.startswith("resid")
                for token in tokens
            )

            tiene_calcareo = any(
                token.startswith("calc")
                or token.startswith("carb")
                for token in tokens
            )

            if tiene_organico:
                if tiene_residuo or tiene_calcareo:
                    return (
                        "material organico"
                    )

                return "material organico"

            # Regla del proyecto: toda variante de Arenisca es Arena.
            valor_compacto = re.sub(
                ur"[^a-z0-9]+",
                "",
                valor
            )

            if (
                "arenisc" in valor_compacto or
                valor_compacto.startswith("aren") or
                valor_compacto in ("ar", "3")
            ):
                return "arena de grano fino"

            # Lutita sin color se representa como lutita gris.
            if valor == "lutita":
                return "lutita gris"

            # Clasificacion explicita de gravas.
            if (
                valor == "gr" or
                valor == "grava" or
                valor == "gravas" or
                valor.startswith("grava")
            ):
                return "gravas"

            if (
                valor == "cg" or
                "conglomerado" in valor
            ):
                return "conglomerado"

            if valor in ESTILOS_LITOLOGIA:
                return valor

            if "lutita" in valor and "marron" in valor:
                return "lutita marron"
            if "lutita" in valor:
                return "lutita gris"
            if "arena" in valor and "fino" in valor and "gris" in valor:
                return "arena de grano fino color gris"
            if "grava" in valor:
                return "gravas"
            if "conglomerado" in valor:
                return "conglomerado"
            if "arena" in valor and "grues" in valor:
                return "arena de grano grueso"
            if "arena" in valor and "fino" in valor:
                return "arena de grano fino"
            if "arena" in valor and "amarill" in valor:
                return "arena amarilla"
            if "arena" in valor and "marron" in valor:
                return "arena color marron"
            if "arcilla" in valor and "plomo" in valor:
                return "arcilla color plomo"
            if "arcilla" in valor and "gris" in valor:
                return "arcilla gris"
            if "arcilla" in valor and "cafe" in valor:
                return "arcilla cafe"
            if "arcilla" in valor and "marron" in valor:
                return "arcilla marron"
            if "arcilla" in valor:
                return "arcilla"

            return registrar_litologia_nueva(nombre)

        def normalizar(texto):
            valor = texto_unicode(texto).lower().strip()

            # Reparaciones frecuentes de UTF-8 interpretado como CP1252.
            reparaciones = {}

            for origen, destino in reparaciones.items():
                valor = valor.replace(
                    origen.lower(),
                    destino
                )

            # Descomponer Unicode y eliminar marcas diacriticas.
            try:
                valor_descompuesto = unicodedata.normalize(
                    "NFKD",
                    valor
                )

                valor = u"".join(
                    caracter
                    for caracter in valor_descompuesto
                    if not unicodedata.combining(
                        caracter
                    )
                )
            except Exception:
                pass

            # Conservar solamente letras, numeros y espacios.
            limpio = []

            for caracter in valor:
                if caracter.isalnum():
                    limpio.append(caracter)
                else:
                    limpio.append(u" ")

            valor = u" ".join(
                u"".join(limpio).split()
            )

            return valor

        def orientacion_cardinal(dx, dy):
            """
            Devuelve orientacion cardinal de 8 rumbos usando dx Este y dy Norte.
            """
            angulo = math.degrees(math.atan2(dx, dy))
            if angulo < 0:
                angulo += 360.0

            rumbos = [
                "N", "NE", "E", "SE",
                "S", "SW", "W", "NW"
            ]

            indice = int((angulo + 22.5) // 45.0) % 8
            return rumbos[indice]

        def rumbo_opuesto(rumbo):
            opuestos = {
                "N": "S", "NE": "SW", "E": "W", "SE": "NW",
                "S": "N", "SW": "NE", "W": "E", "NW": "SE"
            }
            return opuestos.get(rumbo, "")

        def clave_sondeo(valor):
            """
            Normaliza identificadores como:
            Sondeo 1, Sondeo 01, S-01, 01, 1, 1.0 -> 01.

            ArcMap puede leer columnas CSV numericas como float; por eso
            primero se intenta interpretar el valor como numero completo.
            """
            if valor is None:
                return ""

            # Caso numerico real: 1, 1.0, 2.0, etc.
            try:
                if isinstance(valor, (int, long, float)):
                    numero = int(round(float(valor)))
                    return "{0:02d}".format(numero)
            except Exception:
                pass

            texto_original = texto_unicode(valor).strip()

            # Caso texto numerico: "1.0", "01.0", "2"
            try:
                numero_float = float(
                    texto_original.replace(",", ".")
                )
                numero = int(round(numero_float))
                return "{0:02d}".format(numero)
            except Exception:
                pass

            texto = normalizar(texto_original)

            # Buscar el primer grupo continuo de digitos.
            grupo = ""
            iniciado = False

            for caracter in texto:
                if caracter.isdigit():
                    grupo += caracter
                    iniciado = True
                elif iniciado:
                    break

            if grupo:
                try:
                    return "{0:02d}".format(int(grupo))
                except Exception:
                    return grupo

            return texto.replace(" ", "").replace("-", "")

        def nombre_sondeo(valor):
            clave = clave_sondeo(valor)

            try:
                return "Sondeo {0:02d}".format(int(clave))
            except Exception:
                return texto_unicode(valor).strip()

        def leer_puntos_factibilidad_cercanos(
            capa_puntos,
            linea_seccion,
            radio_lateral
        ):
            """
            Proyecta sobre la seccion los puntos de factibilidad que se
            encuentran cerca de la linea 2D. Solo se usan para correlacion
            visual y etiquetado; no modifican la interpolacion geologica.
            """
            if not capa_puntos:
                return []

            campo_nombre_fact = buscar_campo(
                capa_puntos,
                [
                    "SONDEO",
                    "PUNTO",
                    "NOMBRE",
                    "ID_SONDEO",
                    "ID",
                    "CLAVE"
                ]
            )
            campo_elev_fact = buscar_campo(
                capa_puntos,
                [
                    "ELEV_BOCA",
                    "ELEVACION",
                    "COTA",
                    "Z",
                    "ELEV"
                ]
            )
            campo_prof_fact = buscar_campo(
                capa_puntos,
                [
                    "PROF_TOTAL",
                    "PROFUNDIDAD",
                    "PROFUNDI_1",
                    "PROFUNDIDA"
                ]
            )

            campos_cursor = ["SHAPE@"]
            campos_extra = []

            for campo_local in [
                campo_nombre_fact,
                campo_elev_fact,
                campo_prof_fact
            ]:
                if campo_local and campo_local not in campos_extra:
                    campos_extra.append(campo_local)

            campos_cursor.extend(campos_extra)
            puntos = []

            try:
                with arcpy.da.SearchCursor(
                    capa_puntos,
                    campos_cursor
                ) as cursor_fact:
                    for fila_fact in cursor_fact:
                        geometria_fact = fila_fact[0]

                        if geometria_fact is None:
                            continue

                        valores = {}

                        for indice_campo, nombre_campo in enumerate(
                            campos_extra,
                            start=1
                        ):
                            valores[nombre_campo] = fila_fact[
                                indice_campo
                            ]

                        try:
                            consulta_fact = linea_seccion.queryPointAndDistance(
                                geometria_fact,
                                False
                            )
                            distancia_fact = float(
                                consulta_fact[1]
                            )
                            offset_fact = abs(
                                float(consulta_fact[2])
                            )
                        except Exception:
                            continue

                        if offset_fact > float(radio_lateral):
                            continue

                        nombre_crudo = None
                        if campo_nombre_fact:
                            nombre_crudo = valores.get(
                                campo_nombre_fact,
                                None
                            )

                        nombre_legible = nombre_sondeo(
                            nombre_crudo if nombre_crudo not in (None, "")
                            else "Ref"
                        )

                        elevacion_fact = None
                        if campo_elev_fact:
                            elevacion_fact = numero_seguro(
                                valores.get(campo_elev_fact),
                                None
                            )

                        if elevacion_fact is None:
                            try:
                                punto_geom = geometria_fact.firstPoint
                                if punto_geom and punto_geom.Z not in (None,):
                                    elevacion_fact = float(
                                        punto_geom.Z
                                    )
                            except Exception:
                                elevacion_fact = None

                        profundidad_fact = None
                        if campo_prof_fact:
                            profundidad_fact = numero_seguro(
                                valores.get(campo_prof_fact),
                                None
                            )

                        puntos.append({
                            "sid": nombre_legible,
                            "clave": clave_sondeo(nombre_crudo),
                            "x": distancia_fact,
                            "offset": offset_fact,
                            "elevacion": elevacion_fact,
                            "profundidad": profundidad_fact,
                            "geom": geometria_fact
                        })
            except Exception as exc:
                warn_local(
                    "No fue posible leer los puntos de factibilidad cercanos: {0}"
                    .format(exc)
                )
                return []

            puntos.sort(
                key=lambda item: (
                    item["x"],
                    item["offset"]
                )
            )

            puntos_filtrados = []

            for punto_fact in puntos:
                if not puntos_filtrados:
                    puntos_filtrados.append(punto_fact)
                    continue

                anterior_fact = puntos_filtrados[-1]

                if abs(punto_fact["x"] - anterior_fact["x"]) < 5.0:
                    if punto_fact["offset"] < anterior_fact["offset"]:
                        puntos_filtrados[-1] = punto_fact
                else:
                    puntos_filtrados.append(punto_fact)

            if puntos_filtrados:
                msg_local(
                    "Puntos de factibilidad cercanos para correlacion: {0} dentro de 2000 m laterales."
                    .format(len(puntos_filtrados))
                )
            else:
                msg_local(
                    "No se encontraron puntos de factibilidad cercanos dentro de 2000 m laterales."
                )

            return puntos_filtrados

        def clasificar_litologia(nombre):
            valor = normalizar(nombre)

            if "lutita" in valor:
                return "LUTITA"

            if "arena" in valor:
                if "fino" in valor or "fina" in valor:
                    return "ARENA_FINA"

                if "grueso" in valor or "gruesa" in valor:
                    return "ARENA_GRUESA"

                return "ARENA"

            if "arcilla" in valor or "organico" in valor:
                return "COBERTURA"

            return "COBERTURA"

        def media_movil(valores, ventana_local):
            if ventana_local < 2:
                return list(valores)

            if ventana_local % 2 == 0:
                ventana_local += 1

            mitad = ventana_local // 2
            resultado = []

            for i in range(len(valores)):
                inicio = max(0, i - mitad)
                fin = min(len(valores), i + mitad + 1)
                segmento = valores[inicio:fin]

                resultado.append(
                    sum(segmento) / float(len(segmento))
                )

            return resultado

        def suavizar_repetido(valores, ventana_local, repeticiones):
            resultado = list(valores)

            for _ in range(max(1, repeticiones)):
                resultado = media_movil(
                    resultado,
                    ventana_local
                )

            return resultado

        def interpolar_lineal(xs, ys, x):
            if x <= xs[0]:
                return ys[0]

            if x >= xs[-1]:
                return ys[-1]

            for i in range(len(xs) - 1):
                if xs[i] <= x <= xs[i + 1]:
                    dx = xs[i + 1] - xs[i]

                    if dx == 0:
                        return ys[i]

                    t = (x - xs[i]) / float(dx)

                    return ys[i] + t * (ys[i + 1] - ys[i])

            return ys[-1]

        def interpolar_geologico(xs, ys, x):
            """
            Interpolacion tipo smoothstep entre sondeos.
            Mantiene el valor observado en cada sondeo y genera
            transiciones suaves sin sobrepasar los espesores extremos.
            """
            if not xs:
                return 0.0

            if len(xs) == 1:
                return ys[0]

            if x <= xs[0]:
                return ys[0]

            if x >= xs[-1]:
                return ys[-1]

            for i in range(len(xs) - 1):
                if xs[i] <= x <= xs[i + 1]:
                    distancia = xs[i + 1] - xs[i]

                    if distancia <= 0:
                        return ys[i]

                    t = (x - xs[i]) / float(distancia)

                    # Exponente efectivo de continuidad:
                    # Baja mantiene mayor control local; Alta y Muy alta
                    # amplian la transicion entre controles.
                    t_potencia = t ** potencia_interpolado
                    inverso_potencia = (
                        1.0 - t
                    ) ** potencia_interpolado

                    denominador_potencia = (
                        t_potencia + inverso_potencia
                    )

                    if denominador_potencia > 0:
                        t = (
                            t_potencia /
                            denominador_potencia
                        )

                    # Smootherstep quintico: pendiente y curvatura
                    # nulas en los extremos.
                    t_suave = (
                        t * t * t *
                        (
                            t * (
                                t * 6.0 - 15.0
                            ) + 10.0
                        )
                    )

                    return (
                        ys[i] +
                        (ys[i + 1] - ys[i]) * t_suave
                    )

            return ys[-1]

        def suavizar_contacto(valores, iteraciones):
            resultado = list(valores)

            for _ in range(iteraciones):
                if len(resultado) < 5:
                    break

                nuevo = list(resultado)

                for i in range(2, len(resultado) - 2):
                    nuevo[i] = (
                        resultado[i - 2] +
                        2.0 * resultado[i - 1] +
                        3.0 * resultado[i] +
                        2.0 * resultado[i + 1] +
                        resultado[i + 2]
                    ) / 9.0

                resultado = nuevo

            return resultado

        def numero_seguro(valor, defecto=None):
            if valor is None:
                return defecto
            try:
                return float(
                    texto_unicode(valor).strip().replace(",", ".")
                )
            except Exception:
                return defecto

